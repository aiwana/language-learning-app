# =========================================================================
# File .gitignore chuẩn cho dự án ASP.NET Core & Web Frontend
# =========================================================================

# 1. Các file sinh ra khi Biên dịch / Build dự án C#
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleasePublic/
x64/
x86/
build/
.build-check/
bin/
obj/

# 2. File cấu hình cá nhân của Visual Studio & VS Code (Tránh xung đột cấu hình máy)
.vs/
.vscode/
.cursor/
*.suo
*.user
*.userosscache
*.sln.docstates

# Loại trừ file cấu hình user cụ thể
WebShadowing.csproj.user

# 3. Thư viện Frontend (Nếu sau này bạn có dùng npm / nodejs)
node_modules/
.npm/
live-server/

# 4. File nhật ký (Logs) và file rác của hệ điều hành
*.log
.DS_Store
Thumbs.db

# 5. Cấu hình bảo mật và Database cục bộ (Tránh lộ thông tin nhạy cảm)
.env
.env.*
appsettings.Development.json
appsettings.Local.json
**/appsettings.Local.json
secrets.json
*.secret.json
**/UserSecrets/
**/App_Data/DataProtectionKeys/
*.db
*.db-journal
*.sqlite

# 6. Test & coverage
TestResults/
coverage/

# 7. Các file tạm thời sinh ra khi chạy ứng dụng .NET
.net/
*.pubxml
*.pfx
*.publishproj

# 8. Python & Tools virtual environments and cache
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# 9. Workspace Temporary Folders & AI Agent Artifacts
artifacts/
tmp/

# 10. Media do ứng dụng tự sinh lúc chạy (Storage:LocalPath trong appsettings)
# Đây là audio TTS / bài học AI sinh ra trên từng máy, tái tạo được nên không commit.
# Vẫn giữ lại thư mục để ứng dụng không lỗi khi ghi file lần đầu.
WebShadowing/wwwroot/media/generated/*
!WebShadowing/wwwroot/media/generated/.gitkeep

# 11. File tải dở và file tạm (hay lẫn vào wwwroot/media khi tải tài liệu)
*.crdownload
*.part
*.partial
*.download
*.tmp
*.temp
*.bak
*~

# 12. Output build/publish, package và test artifacts còn thiếu
[Pp]ublish/
*.nupkg
*.snupkg
packages/
*.binlog
*.trx
*.coverage
*.coveragexml
[Tt]est[Rr]esult*/
BenchmarkDotNet.Artifacts/

# 13. IDE khác và file rác hệ điều hành
.idea/
*.swp
*.swo
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
