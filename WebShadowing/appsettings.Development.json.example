{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EnglishShadowingDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "OpenAI": {
    "AudioModel": "gpt-audio",
    "TextModel": "gpt-4o-mini",
    "ApiKey": ""
  },
  "AzureSpeech": {
    "ApiKey": "",
    "Region": ""
  },
  "PronunciationAssessment": {
    "EnableOpenAiFallback": true,
    "MaxAudioDurationSeconds": 30,
    "ProviderTimeoutSeconds": 20,
    "AzureProviderName": "azure-speech",
    "OpenAiProviderName": "openai-fallback"
  },
  "VipStub": {
    "Enabled": true
  },
  "Payment": {
    "Momo": {
      "PartnerCode": "set-via-user-secrets",
      "AccessKey": "set-via-user-secrets",
      "SecretKey": "set-via-user-secrets",
      "RedirectUrl": "https://localhost:7274/settings?payment=return",
      "IpnUrl": "https://your-public-tunnel.example/api/payment/webhooks/momo"
    },
    "ZaloPay": {
      "AppId": "set-via-user-secrets",
      "Key1": "set-via-user-secrets",
      "Key2": "set-via-user-secrets",
      "CallbackUrl": "https://your-public-tunnel.example/api/payment/webhooks/zalopay"
    }
  },
  "Gamification": {
    "SentenceCompletionExp": 20,
    "FailedAttemptHeartCost": 1,
    "HeartExchangeExpCost": 100,
    "HeartExchangeAmount": 1,
    "MaxHearts": 5,
    "BusinessTimeZone": "Asia/Ho_Chi_Minh"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
