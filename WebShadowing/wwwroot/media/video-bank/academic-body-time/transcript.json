[
  {
    "sentence_order": 1,
    "start_time": 6.988,
    "end_time": 11.477,
    "text": "In 1962, a cave explorer named Michel Siffre",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 2,
    "start_time": 11.477,
    "end_time": 17.266,
    "text": "started a series of experiments where he isolated himself underground for months",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 3,
    "start_time": 17.266,
    "end_time": 20.405,
    "text": "without light or clocks.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 4,
    "start_time": 20.405,
    "end_time": 24.296,
    "text": "He attached himself to electrodes that monitored his vital signs",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 5,
    "start_time": 24.296,
    "end_time": 28.225,
    "text": "and kept track of when he slept and ate.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 6,
    "start_time": 28.225,
    "end_time": 30.165,
    "text": "When Siffre finally emerged,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 7,
    "start_time": 30.165,
    "end_time": 32.645,
    "text": "the results of his pioneering experiments",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 8,
    "start_time": 32.645,
    "end_time": 37.575,
    "text": "revealed that his body had kept to a regular sleeping-waking cycle.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 9,
    "start_time": 37.575,
    "end_time": 40.654,
    "text": "Despite having no external cues,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 10,
    "start_time": 40.654,
    "end_time": 42.035,
    "text": "he fell asleep,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 11,
    "start_time": 42.035,
    "end_time": 42.975,
    "text": "woke up,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 12,
    "start_time": 42.975,
    "end_time": 46.246,
    "text": "and ate at fixed intervals.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 13,
    "start_time": 46.246,
    "end_time": 52.385,
    "text": "This became known as a circadian rhythm from the Latin for \"about a day.\"",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 14,
    "start_time": 52.385,
    "end_time": 56.676,
    "text": "Scientists later found these rhythms affect our hormone secretion,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 15,
    "start_time": 56.676,
    "end_time": 58.563,
    "text": "how our bodies process food,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 16,
    "start_time": 58.563,
    "end_time": 61.807,
    "text": "and even the effects of drugs on our bodies.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 17,
    "start_time": 61.807,
    "end_time": 67.666,
    "text": "The field of sciences studying these changes is called chronobiology.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 18,
    "start_time": 67.666,
    "end_time": 72.277,
    "text": "Being able to sense time helps us do everything from waking and sleeping",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 19,
    "start_time": 72.277,
    "end_time": 77.906,
    "text": "to knowing precisely when to catch a ball that's hurtling towards us.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 20,
    "start_time": 77.906,
    "end_time": 82.107,
    "text": "We owe all these abilities to an interconnected system of timekeepers",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 21,
    "start_time": 82.107,
    "end_time": 83.627,
    "text": "in our brains.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 22,
    "start_time": 83.627,
    "end_time": 88.117,
    "text": "It contains the equivalent of a stopwatch telling us how many seconds elapsed,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 23,
    "start_time": 88.117,
    "end_time": 90.776,
    "text": "a clock counting the hours of the day,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 24,
    "start_time": 90.776,
    "end_time": 94.148,
    "text": "and a calendar notifying us of the seasons.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 25,
    "start_time": 94.148,
    "end_time": 97.457,
    "text": "Each one is located in a different brain region.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 26,
    "start_time": 97.457,
    "end_time": 101.917,
    "text": "Siffre, stuck in his dark cave, relied on the most primitive clock",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 27,
    "start_time": 101.917,
    "end_time": 107.587,
    "text": "in the suprachiasmatic nucleus, or SCN of the hypothalamus.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 28,
    "start_time": 107.587,
    "end_time": 112.875,
    "text": "Here's the basics of how we think it works based on fruitfly and mouse studies.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 29,
    "start_time": 112.875,
    "end_time": 118.873,
    "text": "Proteins known as CLK, or clock, accumulate in the SCN throughout the day.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 30,
    "start_time": 118.873,
    "end_time": 122.657,
    "text": "In addition to activating genes that tell us to stay awake,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 31,
    "start_time": 122.657,
    "end_time": 125.294,
    "text": "they make another protein called PER.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 32,
    "start_time": 125.294,
    "end_time": 127.174,
    "text": "When enough PER accumulates,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 33,
    "start_time": 127.174,
    "end_time": 129.718,
    "text": "it deactivates the gene that makes CLK,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 34,
    "start_time": 129.718,
    "end_time": 131.977,
    "text": "eventually making us fall asleep.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 35,
    "start_time": 131.977,
    "end_time": 137.256,
    "text": "Then, clock falls low, so PER concentrations also drop again,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 36,
    "start_time": 137.256,
    "end_time": 139.158,
    "text": "allowing CLK to rise,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 37,
    "start_time": 139.158,
    "end_time": 141.551,
    "text": "starting the cycle over.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 38,
    "start_time": 141.551,
    "end_time": 143.335,
    "text": "There are other proteins involved,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 39,
    "start_time": 143.335,
    "end_time": 148.318,
    "text": "but our day and night cycle may be driven in part by this seesaw effect",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 40,
    "start_time": 148.318,
    "end_time": 152.169,
    "text": "between CLK by day and PER by night.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 41,
    "start_time": 152.169,
    "end_time": 154.561,
    "text": "For more precision,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 42,
    "start_time": 154.561,
    "end_time": 156.697,
    "text": "our SCNs also rely on external cues",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 43,
    "start_time": 156.697,
    "end_time": 157.427,
    "text": "like light,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 44,
    "start_time": 157.427,
    "end_time": 158.137,
    "text": "food,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 45,
    "start_time": 158.137,
    "end_time": 158.861,
    "text": "noise,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 46,
    "start_time": 158.861,
    "end_time": 160.027,
    "text": "and temperature.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 47,
    "start_time": 160.027,
    "end_time": 161.659,
    "text": "We called these zeitgebers,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 48,
    "start_time": 161.659,
    "end_time": 164.268,
    "text": "German for \"givers of time.\"",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 49,
    "start_time": 164.268,
    "end_time": 166.827,
    "text": "Siffre lacked many of these cues underground,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 50,
    "start_time": 166.827,
    "end_time": 170.848,
    "text": "but in normal life, they fine tune our daily behavior.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 51,
    "start_time": 170.848,
    "end_time": 174.378,
    "text": "For instance, as natural morning light filters into our eyes,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 52,
    "start_time": 174.378,
    "end_time": 176.209,
    "text": "it helps wake us up.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 53,
    "start_time": 176.209,
    "end_time": 179.083,
    "text": "Traveling through the optic nerve to the SCN,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 54,
    "start_time": 179.083,
    "end_time": 182.398,
    "text": "it communicates what's happening in the outside world.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 55,
    "start_time": 182.398,
    "end_time": 185.668,
    "text": "The hypothalamus then halts the production of melatonin,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 56,
    "start_time": 185.668,
    "end_time": 187.859,
    "text": "a hormone that triggers sleep.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 57,
    "start_time": 187.859,
    "end_time": 188.978,
    "text": "At the same time,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 58,
    "start_time": 188.978,
    "end_time": 191.639,
    "text": "it increases the production of vasopressin",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 59,
    "start_time": 191.639,
    "end_time": 194.11,
    "text": "and noradrenaline throughout the brain,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 60,
    "start_time": 194.11,
    "end_time": 196.649,
    "text": "which help control our sleep cycles.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 61,
    "start_time": 196.649,
    "end_time": 197.989,
    "text": "At about 10 am,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 62,
    "start_time": 197.989,
    "end_time": 202.06,
    "text": "the body's rising temperature drives up our energy and alertness,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 63,
    "start_time": 202.06,
    "end_time": 203.62,
    "text": "and later in the afternoon,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 64,
    "start_time": 203.62,
    "end_time": 207.448,
    "text": "it also improves our muscle activity and coordination.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 65,
    "start_time": 207.448,
    "end_time": 210.799,
    "text": "Bright screens at night can confuse these signals,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 66,
    "start_time": 210.799,
    "end_time": 215.829,
    "text": "which is why binging on TV before bed makes it harder to sleep.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 67,
    "start_time": 215.829,
    "end_time": 219.55,
    "text": "But sometimes we need to be even more precise when telling the time,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 68,
    "start_time": 219.55,
    "end_time": 223.0,
    "text": "which is where the brain's internal stopwatch chimes in.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 69,
    "start_time": 223.0,
    "end_time": 226.087,
    "text": "One theory for how this works involves the fact",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 70,
    "start_time": 226.087,
    "end_time": 229.069,
    "text": "that communication between a given pair of neurons",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 71,
    "start_time": 229.069,
    "end_time": 232.581,
    "text": "always takes roughly the same amount of time.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 72,
    "start_time": 232.581,
    "end_time": 236.08,
    "text": "So neurons in our cortex and other brain areas",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 73,
    "start_time": 236.08,
    "end_time": 239.469,
    "text": "may communicate in scheduled, predictable loops",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 74,
    "start_time": 239.469,
    "end_time": 244.67,
    "text": "that the cortex uses to judge with precision how much time has passed.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 75,
    "start_time": 244.67,
    "end_time": 247.321,
    "text": "That creates our perception of time.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 76,
    "start_time": 247.321,
    "end_time": 251.882,
    "text": "In his cave, Siffre made a fascinating additional discovery about this.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 77,
    "start_time": 251.882,
    "end_time": 256.312,
    "text": "Every day, he challenged himself to count up to 120",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 78,
    "start_time": 256.312,
    "end_time": 259.511,
    "text": "at the rate of one digit per second.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 79,
    "start_time": 259.511,
    "end_time": 265.439,
    "text": "Over time, instead of taking two minutes, it began taking him as long as five.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 80,
    "start_time": 265.439,
    "end_time": 270.658,
    "text": "Life in the lonely, dark cave had warped Siffre's own perception of time",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 81,
    "start_time": 270.658,
    "end_time": 274.421,
    "text": "despite his brain's best efforts to keep him on track.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 82,
    "start_time": 274.421,
    "end_time": 278.332,
    "text": "This makes us wonder what else influences our sense of time.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 83,
    "start_time": 278.332,
    "end_time": 281.482,
    "text": "And if time isn't objective, what does that mean?",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 84,
    "start_time": 281.482,
    "end_time": 284.421,
    "text": "Could each of us be experiencing it differently?",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 85,
    "start_time": 284.421,
    "end_time": 286.551,
    "text": "Only time will tell.",
    "translation": null,
    "ipa": null
  }
]
