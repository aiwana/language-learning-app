[
  {
    "sentence_order": 1,
    "start_time": 6.505,
    "end_time": 8.807,
    "text": "Water is virtually everywhere,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 2,
    "start_time": 8.807,
    "end_time": 11.259,
    "text": "from soil moisture and ice caps,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 3,
    "start_time": 11.259,
    "end_time": 14.086,
    "text": "to the cells inside our own bodies.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 4,
    "start_time": 14.086,
    "end_time": 16.181,
    "text": "Depending on factors like location,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 5,
    "start_time": 16.181,
    "end_time": 17.399,
    "text": "fat index,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 6,
    "start_time": 17.399,
    "end_time": 18.114,
    "text": "age,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 7,
    "start_time": 18.114,
    "end_time": 19.202,
    "text": "and sex,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 8,
    "start_time": 19.202,
    "end_time": 23.808,
    "text": "the average human is between 55-60% water.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 9,
    "start_time": 23.808,
    "end_time": 27.024,
    "text": "At birth, human babies are even wetter.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 10,
    "start_time": 27.024,
    "end_time": 32.307,
    "text": "Being 75% water, they are swimmingly similar to fish.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 11,
    "start_time": 32.307,
    "end_time": 37.331,
    "text": "But their water composition drops to 65% by their first birthday.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 12,
    "start_time": 37.331,
    "end_time": 40.196,
    "text": "So what role does water play in our bodies,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 13,
    "start_time": 40.196,
    "end_time": 44.288,
    "text": "and how much do we actually need to drink to stay healthy?",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 14,
    "start_time": 44.288,
    "end_time": 48.529,
    "text": "The H20 in our bodies works to cushion and lubricate joints,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 15,
    "start_time": 48.529,
    "end_time": 49.948,
    "text": "regulate temperature,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 16,
    "start_time": 49.948,
    "end_time": 53.932,
    "text": "and to nourish the brain and spinal cord.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 17,
    "start_time": 53.932,
    "end_time": 56.062,
    "text": "Water isn't only in our blood.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 18,
    "start_time": 56.062,
    "end_time": 60.51,
    "text": "An adult's brain and heart are almost three quarters water.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 19,
    "start_time": 60.51,
    "end_time": 64.367,
    "text": "That's roughly equivalent to the amount of moisture in a banana.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 20,
    "start_time": 64.367,
    "end_time": 68.487,
    "text": "Lungs are more similar to an apple at 83%.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 21,
    "start_time": 68.487,
    "end_time": 74.31,
    "text": "And even seemingly dry human bones are 31% water.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 22,
    "start_time": 74.31,
    "end_time": 76.051,
    "text": "If we are essentially made of water,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 23,
    "start_time": 76.051,
    "end_time": 77.634,
    "text": "and surrounded by water,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 24,
    "start_time": 77.634,
    "end_time": 80.492,
    "text": "why do we still need to drink so much?",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 25,
    "start_time": 80.492,
    "end_time": 84.293,
    "text": "Well, each day we lose two to three liters through our sweat,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 26,
    "start_time": 84.293,
    "end_time": 85.227,
    "text": "urine,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 27,
    "start_time": 85.227,
    "end_time": 86.707,
    "text": "and bowel movements,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 28,
    "start_time": 86.707,
    "end_time": 88.371,
    "text": "and even just from breathing.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 29,
    "start_time": 88.371,
    "end_time": 90.859,
    "text": "While these functions are essential to our survival,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 30,
    "start_time": 90.859,
    "end_time": 93.306,
    "text": "we need to compensate for the fluid loss.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 31,
    "start_time": 93.306,
    "end_time": 97.848,
    "text": "Maintaining a balanced water level is essential to avoid dehydration",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 32,
    "start_time": 97.848,
    "end_time": 99.71,
    "text": "or over-hydration,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 33,
    "start_time": 99.71,
    "end_time": 103.279,
    "text": "both of which can have devastating effects on overall health.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 34,
    "start_time": 103.279,
    "end_time": 105.404,
    "text": "At first detection of low water levels,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 35,
    "start_time": 105.404,
    "end_time": 108.367,
    "text": "sensory receptors in the brain's hypothalamus",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 36,
    "start_time": 108.367,
    "end_time": 111.399,
    "text": "signal the release of antidiuretic hormone.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 37,
    "start_time": 111.399,
    "end_time": 114.489,
    "text": "When it reached the kidneys, it creates aquaporins,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 38,
    "start_time": 114.489,
    "end_time": 120.445,
    "text": "special channels that enable blood to absorb and retain more water,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 39,
    "start_time": 120.445,
    "end_time": 123.05,
    "text": "leading to concentrated, dark urine.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 40,
    "start_time": 123.05,
    "end_time": 126.555,
    "text": "Increased dehydration can cause notable drops in energy,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 41,
    "start_time": 126.555,
    "end_time": 127.586,
    "text": "mood,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 42,
    "start_time": 127.586,
    "end_time": 128.774,
    "text": "skin moisture,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 43,
    "start_time": 128.774,
    "end_time": 130.198,
    "text": "and blood pressure,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 44,
    "start_time": 130.198,
    "end_time": 133.252,
    "text": "as well as signs of cognitive impairment.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 45,
    "start_time": 133.252,
    "end_time": 137.21,
    "text": "A dehydrated brain works harder to accomplish the same amount",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 46,
    "start_time": 137.21,
    "end_time": 138.696,
    "text": "as a normal brain,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 47,
    "start_time": 138.696,
    "end_time": 142.618,
    "text": "and it even temporarily shrinks because of its lack of water.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 48,
    "start_time": 142.618,
    "end_time": 145.614,
    "text": "Over-hydration, or hyponatremia,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 49,
    "start_time": 145.614,
    "end_time": 150.669,
    "text": "is usually caused by overconsumption of water in a short amount of time.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 50,
    "start_time": 150.669,
    "end_time": 153.242,
    "text": "Athletes are often the victims of over-hydration",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 51,
    "start_time": 153.242,
    "end_time": 156.585,
    "text": "because of complications in regulating water levels",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 52,
    "start_time": 156.585,
    "end_time": 159.263,
    "text": "in extreme physical conditions.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 53,
    "start_time": 159.263,
    "end_time": 163.769,
    "text": "Whereas the dehydrated brain amps up the production of antidiuretic hormone,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 54,
    "start_time": 163.769,
    "end_time": 169.174,
    "text": "the over-hydrated brain slows, or even stops, releasing it into the blood.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 55,
    "start_time": 169.174,
    "end_time": 171.98,
    "text": "Sodium electrolytes in the body become diluted,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 56,
    "start_time": 171.98,
    "end_time": 174.133,
    "text": "causing cells to swell.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 57,
    "start_time": 174.133,
    "end_time": 175.584,
    "text": "In severe cases,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 58,
    "start_time": 175.584,
    "end_time": 179.768,
    "text": "the kidneys can't keep up with the resulting volumes of dilute urine.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 59,
    "start_time": 179.768,
    "end_time": 181.923,
    "text": "Water intoxication then occurs,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 60,
    "start_time": 181.923,
    "end_time": 183.559,
    "text": "possibly causing headache,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 61,
    "start_time": 183.559,
    "end_time": 184.688,
    "text": "vomiting,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 62,
    "start_time": 184.688,
    "end_time": 188.162,
    "text": "and, in rare instances, seizures or death.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 63,
    "start_time": 188.162,
    "end_time": 190.295,
    "text": "But that's a pretty extreme situation.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 64,
    "start_time": 190.295,
    "end_time": 192.062,
    "text": "On a normal, day-to-day basis,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 65,
    "start_time": 192.062,
    "end_time": 195.632,
    "text": "maintaining a well-hydrated system is easy to manage",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 66,
    "start_time": 195.632,
    "end_time": 199.528,
    "text": "for those of us fortunate enough to have access to clean drinking water.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 67,
    "start_time": 199.528,
    "end_time": 203.808,
    "text": "For a long time, conventional wisdom said that we should drink eight glasses a day.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 68,
    "start_time": 203.808,
    "end_time": 206.453,
    "text": "That estimate has since been fine-tuned.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 69,
    "start_time": 206.453,
    "end_time": 210.245,
    "text": "Now, the consensus is that the amount of water we need to imbibe",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 70,
    "start_time": 210.245,
    "end_time": 213.116,
    "text": "depends largely on our weight and environment.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 71,
    "start_time": 213.116,
    "end_time": 219.616,
    "text": "The recommended daily intake varies from between 2.5-3.7 liters of water for men,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 72,
    "start_time": 219.616,
    "end_time": 222.802,
    "text": "and about 2-2.7 liters for women,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 73,
    "start_time": 222.802,
    "end_time": 226.148,
    "text": "a range that is pushed up or down if we are healthy,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 74,
    "start_time": 226.148,
    "end_time": 226.987,
    "text": "active,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 75,
    "start_time": 226.987,
    "end_time": 227.95,
    "text": "old,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 76,
    "start_time": 227.95,
    "end_time": 229.663,
    "text": "or overheating.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 77,
    "start_time": 229.663,
    "end_time": 231.522,
    "text": "While water is the healthiest hydrator,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 78,
    "start_time": 231.522,
    "end_time": 232.617,
    "text": "other beverages,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 79,
    "start_time": 232.617,
    "end_time": 235.23,
    "text": "even those with caffeine like coffee or tea,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 80,
    "start_time": 235.23,
    "end_time": 237.323,
    "text": "replenish fluids as well.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 81,
    "start_time": 237.323,
    "end_time": 242.306,
    "text": "And water within food makes up about a fifth of our daily H20 intake.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 82,
    "start_time": 242.306,
    "end_time": 244.333,
    "text": "Fruits and vegetables like strawberries,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 83,
    "start_time": 244.333,
    "end_time": 245.302,
    "text": "cucumbers,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 84,
    "start_time": 245.302,
    "end_time": 248.874,
    "text": "and even broccoli are over 90% water,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 85,
    "start_time": 248.874,
    "end_time": 254.119,
    "text": "and can supplement liquid intake while providing valuable nutrients and fiber.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 86,
    "start_time": 254.119,
    "end_time": 257.276,
    "text": "Drinking well might also have various long-term benefits.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 87,
    "start_time": 257.276,
    "end_time": 261.618,
    "text": "Studies have shown that optimal hydration can lower the chance of stroke,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 88,
    "start_time": 261.618,
    "end_time": 263.107,
    "text": "help manage diabetes,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 89,
    "start_time": 263.107,
    "end_time": 267.871,
    "text": "and potentially reduce the risk of certain types of cancer.",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 90,
    "start_time": 267.871,
    "end_time": 272.051,
    "text": "No matter what, getting the right amount of liquid makes a world of difference",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 91,
    "start_time": 272.051,
    "end_time": 273.338,
    "text": "in how you'll feel,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 92,
    "start_time": 273.338,
    "end_time": 274.205,
    "text": "think,",
    "translation": null,
    "ipa": null
  },
  {
    "sentence_order": 93,
    "start_time": 274.205,
    "end_time": 276.073,
    "text": "and function day to day.",
    "translation": null,
    "ipa": null
  }
]
