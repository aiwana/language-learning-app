@model ErrorViewModel
@{
    ViewData["Title"] = "Không thể xử lý yêu cầu";
}
<main class="surface-card feature-empty mx-auto my-5" style="max-width: 42rem;">
    <i data-lucide="triangle-alert" aria-hidden="true"></i>
    <h1>Không thể xử lý yêu cầu</h1>
    <p>Hệ thống chưa hoàn tất tác vụ này. Hãy thử lại hoặc quay về thư viện bài học.</p>
    <div class="d-flex justify-content-center gap-2"><button class="btn btn-outline-primary" type="button" onclick="location.reload()">Thử lại</button><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về thư viện</a></div>
    @if (Model.ShowRequestId) { <p class="small text-body-muted mt-3 mb-0">Mã yêu cầu: <code>@Model.RequestId</code></p> }
</main>
