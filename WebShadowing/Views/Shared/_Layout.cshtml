@using WebShadowing.Models
@{
    var profile = ViewBag.UserProfile as UserProfile ?? StaticData.DefaultProfile;
    var stats = ViewBag.UserStats as UserStats ?? StaticData.DefaultStats;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
<!DOCTYPE html>
<html lang="vi" class="">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShadowSpeak AI</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ["Inter", "ui-sans-serif", "system-ui", "sans-serif"],
                        mono: ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"]
                    }
                }
            }
        }
    </script>
    <!-- Custom site.css -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Immediate theme styling application to prevent flash -->
    <script>
        if (localStorage.getItem('shadow_speak_dark_mode') === 'true') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-900 transition-colors duration-300 dark:bg-slate-950 dark:text-slate-50 selection:bg-indigo-500 selection:text-white pb-14 md:pb-0">

    <header id="app-top-header" class="sticky top-0 z-50 bg-white/85 dark:bg-slate-900/85 backdrop-blur-md border-b border-slate-100 dark:border-slate-800 transition-colors duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                
                <!-- Leftside Branding logo -->
                <div class="flex items-center gap-7">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 px-1 focus:outline-none cursor-pointer no-underline">
                        <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white shadow-sm shadow-indigo-600/30">
                            <i data-lucide="code" class="w-4 h-4"></i>
                        </div>
                        <span class="font-sans font-extrabold text-base tracking-tight text-indigo-700 dark:text-sky-400">
                            ShadowSpeak <span class="text-slate-500 font-normal">AI</span>
                        </span>
                    </a>

                    <!-- Main Tabs Navigation -->
                    <nav class="hidden md:flex space-x-1 font-sans font-medium text-sm">
                        <a asp-controller="Home" asp-action="Index"
                           class="px-4.5 py-1.5 rounded-lg transition-all cursor-pointer no-underline @(action == "Index" || action == "LessonDetail" ? "bg-slate-100 text-indigo-600 dark:bg-slate-800/sky-400 dark:text-sky-400 font-semibold" : "text-slate-600 hover:text-slate-950 dark:text-slate-300 dark:hover:text-slate-100")">
                            Khóa Học
                        </a>
                        <a asp-controller="Home" asp-action="Stats"
                           class="px-4.5 py-1.5 rounded-lg transition-all cursor-pointer no-underline @(action == "Stats" ? "bg-slate-100 text-indigo-600 dark:bg-slate-800/sky-400 dark:text-sky-400 font-semibold" : "text-slate-600 hover:text-slate-950 dark:text-slate-300 dark:hover:text-slate-100")">
                            Tiến Trình & Thẻ Nhớ
                        </a>
                        <a asp-controller="Home" asp-action="Settings"
                           class="px-4.5 py-1.5 rounded-lg transition-all cursor-pointer no-underline @(action == "Settings" ? "bg-slate-100 text-indigo-600 dark:bg-slate-800/sky-400 dark:text-sky-400 font-semibold" : "text-slate-600 hover:text-slate-950 dark:text-slate-300 dark:hover:text-slate-100")">
                            Tài Khoản
                        </a>
                    </nav>
                </div>

                <!-- Rightside Statuses and Settings -->
                <div class="flex items-center gap-2 sm:gap-4 font-mono text-xs">
                    
                    <!-- Streak Counter -->
                    <div class="flex items-center gap-1.5 px-2.5 py-1.5 bg-orange-50 text-orange-600 dark:bg-orange-500/10 dark:text-orange-400 rounded-lg" title="Chuỗi ngày học liên tiếp">
                        <i data-lucide="flame" class="w-4 h-4 fill-orange-500 animate-pulse text-orange-500"></i>
                        <span class="font-bold">@stats.Streak Ngày</span>
                    </div>

                    <!-- Heart point system -->
                    <div class="flex items-center gap-1.5 px-2.5 py-1.5 bg-rose-50 text-rose-600 dark:bg-rose-500/10 dark:text-rose-400 rounded-lg" title="Số tim còn lại trong ngày">
                        <i data-lucide="heart" class="w-4 h-4 fill-rose-500 text-rose-500"></i>
                        <span class="font-bold">@(profile.IsPremium ? "∞ Tim" : $"{stats.Hearts} Tim")</span>
                    </div>

                    <!-- EXP Point Counter -->
                    <div class="flex items-center gap-1.5 px-2.5 py-1.5 bg-amber-50 text-amber-600 dark:bg-amber-500/10 dark:text-amber-400 rounded-lg" title="Điểm EXP tích lũy">
                        <i data-lucide="star" class="w-4 h-4 fill-amber-500 text-amber-500"></i>
                        <span class="font-bold">@stats.Exp EXP</span>
                    </div>

                    <!-- Subscription status -->
                    @if (profile.IsPremium)
                    {
                        <div class="hidden lg:flex items-center gap-1.5 px-2.5 py-1.5 bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400 rounded-lg">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 fill-emerald-500 text-emerald-500"></i>
                            <span class="font-bold uppercase tracking-wider text-[10px]">Pro VIP</span>
                        </div>
                    }

                    <!-- Dark & Light Theme Toggling -->
                    <div class="h-5 w-[1px] bg-slate-100 dark:bg-slate-800 mx-1"></div>

                    <button onclick="toggleTheme()"
                            class="p-2 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
                            title="Đổi giao diện Sáng / Tối">
                        <i data-lucide="sun" class="w-4 h-4 dark:hidden"></i>
                        <i data-lucide="moon" class="w-4 h-4 hidden dark:block"></i>
                    </button>

                    <!-- User Info & Out -->
                    <a asp-controller="Home" asp-action="Auth"
                       class="p-2 rounded-lg text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-500/10 transition-colors cursor-pointer"
                       title="Đăng xuất khỏi hệ thống"
                       onclick="return confirm('Bạn có chắc chắn muốn đăng xuất khỏi ứng dụng không?')">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                    </a>

                </div>

            </div>
        </div>
    </header>

    <main class="transition-all duration-300">
        @RenderBody()
    </main>

    <!-- Smart Mobile Tab bar -->
    <div class="md:hidden fixed bottom-0 inset-x-0 bg-white/95 dark:bg-slate-950/95 backdrop-blur-md border-t border-slate-100 dark:border-slate-800 flex justify-around p-2.5 z-40 text-[10px] tracking-tighter">
        <a asp-controller="Home" asp-action="Index"
           class="flex flex-col items-center gap-1 font-bold no-underline @(action == "Index" || action == "LessonDetail" ? "text-indigo-600 dark:text-sky-400" : "text-slate-400")">
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
            <span>Khóa Học</span>
        </a>
        <a asp-controller="Home" asp-action="Stats"
           class="flex flex-col items-center gap-1 font-bold no-underline @(action == "Stats" ? "text-indigo-600 dark:text-sky-400" : "text-slate-400")">
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
            <span>Thẻ Nhớ</span>
        </a>
        <a asp-controller="Home" asp-action="Settings"
           class="flex flex-col items-center gap-1 font-bold no-underline @(action == "Settings" ? "text-indigo-600 dark:text-sky-400" : "text-slate-400")">
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
            <span>Tài Khoản</span>
        </a>
    </div>

    <!-- Lucide Icons script -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        function toggleTheme() {
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('shadow_speak_dark_mode', 'false');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('shadow_speak_dark_mode', 'true');
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
