@model WebShadowing.Models.LibraryViewModel
@{
    ViewData["Title"] = "Thư viện bài học";
    var hasAnyContent = Model.VideoBankCourses.Count > 0
        || Model.CurriculumCourses.Count > 0
        || Model.MyAiLessons.Count > 0;
}
<div class="container py-4">

    <div class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-3xl py-3 px-5 md:py-4 md:px-6 shadow-sm mb-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="h3 fw-extrabold mb-2" style="color: #3B82F6;">Thư viện bài học ShadowSpeak AI</h1>
            <p class="text-muted small mb-0">Video bank, giáo trình unit, hoặc bài AI tự tạo — mỗi card mở cùng phòng luyện Shadowing / Dictation / IPA.</p>
        </div>
        <div class="position-relative" style="min-width: 280px;">
            <span class="position-absolute top-50 start-0 translate-middle-y ps-3 text-slate-400">
                <i data-lucide="search" class="w-4 h-4 text-slate-400"></i>
            </span>
            <input type="text" id="lesson-search-input" onkeyup="filterLessons()" class="form-control rounded-pill border-slate-200 dark:border-slate-800 bg-transparent py-2.5 ps-5 text-sm" placeholder="Tìm bài học..." />
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            @if (!hasAnyContent)
            {
                <div class="alert alert-info">
                    Chưa có khóa học nào trong database. Chạy <code>Designs/Database/UpdateDatabase.sql</code> rồi khởi động lại app.
                </div>
            }
            else
            {
                @if (Model.VideoBankCourses.Count > 0)
                {
                    <div class="mb-2">
                        <span class="text-[10px] font-extrabold uppercase tracking-widest text-pink-500">Video Bank</span>
                    </div>
                    @foreach (var course in Model.VideoBankCourses)
                    {
                        @await Html.PartialAsync("_CourseSection", course)
                    }
                }

                @if (Model.CurriculumCourses.Count > 0)
                {
                    <div class="mb-2 mt-4">
                        <span class="text-[10px] font-extrabold uppercase tracking-widest text-indigo-500">Giáo trình</span>
                    </div>
                    @foreach (var course in Model.CurriculumCourses)
                    {
                        @await Html.PartialAsync("_CourseSection", course)
                    }
                }

                @if (Model.MyAiLessons.Count > 0)
                {
                    <section class="course-section mb-4 mt-4" data-course-title="Bài AI của tôi">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h2 class="h5 fw-bold mb-1 text-slate-800 dark:text-slate-100">Bài AI của tôi</h2>
                                <p class="text-muted small mb-0">Các bài đã lưu từ AI Generator.</p>
                            </div>
                            <span class="text-pink-600 font-extrabold text-[10px] uppercase">@Model.MyAiLessons.Count BÀI</span>
                        </div>
                        <div class="scroll-row">
                            @foreach (var lesson in Model.MyAiLessons)
                            {
                                <div class="scroll-card lesson-card" data-title="@lesson.Title" data-desc="@lesson.Description">
                                    <a asp-action="LessonDetail" asp-route-id="@lesson.LessonId" class="text-decoration-none" style="color: inherit;">
                                        <div class="lesson-inner-card p-3 h-100 d-flex flex-column justify-content-between shadow-sm">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="px-2 py-0.5 rounded text-[9px] font-extrabold uppercase border bg-pink-50 text-pink-700 border-pink-100">AI</span>
                                                    <span class="px-2 py-0.5 rounded text-[9px] font-extrabold uppercase border bg-violet-50 text-violet-700 border-violet-100">ĐÃ LƯU</span>
                                                </div>
                                                <h3 class="fw-bold text-slate-800 dark:text-slate-200 mb-1 leading-snug" style="font-size: 13px;">@lesson.Title</h3>
                                                <p class="text-muted text-xxs mb-2 leading-relaxed line-clamp-2">@lesson.Description</p>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center mt-auto pt-1.5 border-t border-slate-100 dark:border-slate-800/60" style="font-size: 10px;">
                                                <span class="text-muted d-flex align-items-center gap-1">
                                                    <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                                                    <span>AI Generator</span>
                                                </span>
                                                <span class="text-muted d-flex align-items-center gap-1">
                                                    <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                                                    <span>@TimeSpan.FromSeconds(lesson.Duration).ToString(@"m\:ss")</span>
                                                </span>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    </section>
                }
            }
        </div>

        <div class="col-lg-4">
            <div class="card border border-slate-100 dark:border-slate-800 rounded-3xl p-3 bg-white dark:bg-slate-900 shadow-sm font-sans" style="position: sticky; top: 20px;">
                <div class="d-flex align-items-center gap-2 mb-2.5 text-pink-600 dark:text-pink-400">
                    <i data-lucide="sparkles" class="w-4 h-4 text-pink-500 fill-pink-500"></i>
                    <h4 class="fw-extrabold mb-0 text-slate-800 dark:text-slate-100" style="font-size: 14.5px;">Tạo đề tài AI Generator</h4>
                </div>

                <p class="text-muted text-xxs mb-3" style="line-height: 1.35;">
                    Nhập chủ đề để sinh bài luyện tạm (chưa lưu DB). Bấm <strong>Lưu bài AI</strong> trong phòng luyện nếu muốn giữ lại.
                </p>

                @if (!Model.IsAuthenticated)
                {
                    <div class="alert alert-warning text-xxs py-2 mb-0">
                        <a asp-action="Authen" class="alert-link">Đăng nhập</a> để tạo và lưu bài AI.
                    </div>
                }
                else
                {
                    <form id="ai-generator-form" onsubmit="handleGenerateLesson(event)">
                        <div class="mb-2.5">
                            <label class="text-[9px] uppercase font-bold text-slate-400 block mb-1 font-mono">PROMPT NỘI DUNG / CẤP ĐỘ HỌC</label>
                            <textarea id="ai-prompt-input" rows="3" class="form-control text-xs dark:bg-slate-950 dark:border-slate-800 dark:text-slate-100" style="font-size: 11.5px; border-radius: 10px; background-color: #f8fafc;" placeholder="Đoạn hội thoại phỏng vấn tại công ty công nghệ lớn" required>Đoạn hội thoại phỏng vấn tại công ty công nghệ lớn</textarea>
                        </div>

                        <div class="mb-3">
                            <label class="text-[9px] uppercase font-bold text-slate-400 block mb-1 font-mono">CẤP ĐỘ</label>
                            <select id="ai-level-input" class="form-select form-select-sm text-xs">
                                <option value="Beginner">Beginner</option>
                                <option value="Intermediate">Intermediate</option>
                                <option value="Advanced">Advanced</option>
                            </select>
                        </div>

                        <button type="submit" id="generate-ai-btn" class="w-full btn py-2 rounded-xl font-bold text-xs d-flex align-items-center justify-center gap-1.5 text-white border-0" style="background: linear-gradient(135deg, #EC4899, #6366F1); font-size: 11px;">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-white"></i>
                            <span>XUẤT BẢN BÀI GIẢNG AI</span>
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterLessons() {
            const query = document.getElementById('lesson-search-input').value.toLowerCase().trim();
            document.querySelectorAll('.lesson-card').forEach(card => {
                const title = (card.getAttribute('data-title') || '').toLowerCase();
                const desc = (card.getAttribute('data-desc') || '').toLowerCase();
                card.classList.toggle('d-none', !(title.includes(query) || desc.includes(query)));
            });

            document.querySelectorAll('.course-section').forEach(section => {
                const visibleCards = section.querySelectorAll('.lesson-card:not(.d-none)');
                section.classList.toggle('d-none', visibleCards.length === 0);
            });
        }

        function handleGenerateLesson(event) {
            event.preventDefault();
            const prompt = document.getElementById('ai-prompt-input').value.trim();
            const level = document.getElementById('ai-level-input').value;
            if (!prompt) return;

            const btn = document.getElementById('generate-ai-btn');
            const textSpan = btn.querySelector('span');
            const icon = btn.querySelector('i');

            btn.disabled = true;
            btn.style.opacity = '0.8';
            textSpan.textContent = 'ĐANG TẠO BÀI HỌC...';
            if (icon) {
                icon.setAttribute('data-lucide', 'refresh-cw');
                lucide.createIcons();
            }

            fetch('/api/ai/generate', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ prompt, level })
            })
            .then(res => {
                if (res.status === 401) {
                    window.location.href = '/Home/Authen?ReturnUrl=' + encodeURIComponent('/');
                    throw new Error('Unauthorized');
                }
                if (!res.ok) throw new Error('Generate failed');
                return res.json();
            })
            .then(data => {
                window.location.href = data.previewUrl;
            })
            .catch(err => {
                console.error(err);
                alert('Không tạo được bài AI. Vui lòng thử lại.');
                btn.disabled = false;
                btn.style.opacity = '1';
                textSpan.textContent = 'XUẤT BẢN BÀI GIẢNG AI';
            });
        }
    </script>
}
