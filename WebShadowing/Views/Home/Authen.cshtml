@model WebShadowing.Models.AuthPageViewModel
@{
    ViewData["Title"] = "Authentication";
    var activeStep = ViewData["ActiveStep"]?.ToString() ?? "login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="shadow-lg rounded-4 border-0 p-4 bg-white">

                <div class="text-center mb-4">
                    <h2 class="fw-bold">ShadowSpeak AI</h2>
                    <p class="text-muted mb-0">
                        Learn English smarter with AI
                    </p>
                </div>

                @if (TempData["AuthError"] is string error)
                {
                    <div class="alert alert-danger">
                        @error
                    </div>
                }

                @if (activeStep == "level")
                {
                    <div class="text-center">

                        <div class="display-5 mb-3">
                            🎉
                        </div>

                        <h3 class="fw-bold">
                            Welcome!
                        </h3>

                        <p class="text-muted mb-4">
                            Your account has been created successfully.
                            Let's start your learning journey.
                        </p>

                        <div class="progress mb-4" style="height:8px;">
                            <div class="progress-bar" style="width:100%"></div>
                        </div>

                        <div class="card border-0 bg-light rounded-4 p-3 mb-3">

                            <div class="d-flex justify-content-between">

                                <span>Learning Mode</span>

                                <strong>Casual</strong>

                            </div>

                            <hr />

                            <div class="d-flex justify-content-between">

                                <span>Pronunciation Goal</span>

                                <strong>70</strong>

                            </div>

                        </div>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-primary btn-lg w-100">

                            Continue →

                        </a>

                    </div>
                }
                else
                {

                    <div class="auth-tabs mb-4">

                        <button id="loginTab"
                                type="button"
                                class="tab-btn active">

                            Sign In

                        </button>

                        <button id="registerTab"
                                type="button"
                                class="tab-btn">

                            Register

                        </button>

                    </div>

                    <div id="loginPanel">

                        <h4 class="fw-bold mb-3">
                            Welcome Back 👋
                        </h4>

                        <form asp-controller="Account"
                              asp-action="Login"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input asp-for="Login.ReturnUrl"
                                   type="hidden" />

                            <div class="mb-3">

                                <label asp-for="Login.Email"
                                       class="form-label"></label>

                                <input asp-for="Login.Email"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="Login.Email"
                                      class="text-danger small"></span>

                            </div>

                            <div class="mb-4">

                                <label asp-for="Login.Password"
                                       class="form-label"></label>

                                <input asp-for="Login.Password"
                                       type="password"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="Login.Password"
                                      class="text-danger small"></span>

                            </div>

                            <button class="btn btn-primary btn-lg w-100">

                                Sign In

                            </button>

                        </form>

                    </div>

                    <div id="registerPanel" style="display:none;">

                        <h4 class="fw-bold mb-3">
                            Create Account ✨
                        </h4>

                        <form asp-controller="Account"
                              asp-action="Register"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input asp-for="Register.ReturnUrl"
                                   type="hidden" />

                            <div class="mb-3">

                                <label asp-for="Register.FullName"
                                       class="form-label"></label>

                                <input asp-for="Register.FullName"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="Register.FullName"
                                      class="text-danger small"></span>

                            </div>

                            <div class="mb-3">

                                <label asp-for="Register.Email"
                                       class="form-label"></label>

                                <input asp-for="Register.Email"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="Register.Email"
                                      class="text-danger small"></span>

                            </div>

                            <div class="mb-4">

                                <label asp-for="Register.Password"
                                       class="form-label"></label>

                                <input asp-for="Register.Password"
                                       type="password"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="Register.Password"
                                      class="text-danger small"></span>

                            </div>

                            <button class="btn btn-outline-primary btn-lg w-100">

                                Register

                            </button>

                        </form>

                    </div>

                }

            </div>

        </div>
    </div>
</div>

@section Scripts{

    <partial name="_ValidationScriptsPartial" />

    <script>

        const loginTab = document.getElementById("loginTab");
        const registerTab = document.getElementById("registerTab");

        if(loginTab && registerTab){

            const loginPanel=document.getElementById("loginPanel");
            const registerPanel=document.getElementById("registerPanel");

            loginTab.onclick=function(){

                loginTab.classList.add("active");
                registerTab.classList.remove("active");

                loginPanel.style.display="block";
                registerPanel.style.display="none";

            }

            registerTab.onclick=function(){

                registerTab.classList.add("active");
                loginTab.classList.remove("active");

                loginPanel.style.display="none";
                registerPanel.style.display="block";

            }

        }

    </script>

}
