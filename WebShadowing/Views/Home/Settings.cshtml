@{
    ViewData["Title"] = "Tài khoản";
}

<div class="animate-slide-up py-2">
    <div class="surface-card py-4 px-5 py-md-5 px-md-6">
        <p class="section-label section-label-violet mb-1">Tài khoản</p>
        <h1 class="h3 fw-extrabold mb-2">Cài đặt &amp; hồ sơ</h1>
        <p class="text-body-muted small mb-0">Coming soon — nội dung đầy đủ sẽ có ở milestone M2.</p>

        <hr class="my-4 border-secondary opacity-25" />

        <div class="d-flex flex-wrap gap-3 align-items-center settings-mobile-tools">
            <button class="btn btn-outline-secondary btn-sm btn-theme-toggle d-md-none" type="button" aria-label="Chuyển dark/light mode">
                <span class="theme-toggle-label-light">🌙 Giao diện tối</span>
                <span class="theme-toggle-label-dark d-none">☀️ Giao diện sáng</span>
            </button>
        </div>
    </div>
</div>
