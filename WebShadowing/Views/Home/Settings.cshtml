@using WebShadowing.Models
@{
    ViewData["Title"] = "Cài đặt tài khoản & Mục tiêu học";
    var profile = ViewBag.UserProfile as UserProfile ?? StaticData.DefaultProfile;
    var stats = ViewBag.UserStats as UserStats ?? StaticData.DefaultStats;
}

<div id="settings-view-container" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 font-sans animate-slide-up">
      
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        
        <!-- Left column: Edit Profile - 8 cols -->
        <div class="md:col-span-8 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-3xl p-6 md:p-8 shadow-sm">
            <h3 class="text-lg font-extrabold tracking-tight mb-6 text-slate-800 dark:text-slate-100">Cài đặt hồ sơ & Mục tiêu học</h3>
            
            <form onsubmit="handleSaveProfileSubmit(event)" class="space-y-5 text-xs font-sans">
                
                <!-- Input Name form -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] uppercase font-bold text-slate-400 block mb-1.5 font-mono">Tên thành viên</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                                <i data-lucide="user" class="w-4 h-4"></i>
                            </span>
                            <input
                                type="text"
                                required
                                id="profile-name"
                                value="@profile.Name"
                                class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-transparent text-sm focus:outline-none focus:border-indigo-500 font-sans dark:text-white"
                            />
                        </div>
                    </div>

                    <div>
                        <label class="text-[10px] uppercase font-bold text-slate-400 block mb-1.5 font-mono">Số điện thoại liên hệ</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                                <i data-lucide="phone" class="w-4 h-4"></i>
                            </span>
                            <input
                                type="tel"
                                id="profile-phone"
                                value="@profile.Phone"
                                class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-transparent text-sm focus:outline-none focus:border-indigo-500 font-sans dark:text-white"
                                placeholder="09xx xxx xxx"
                            />
                        </div>
                    </div>
                </div>

                <!-- Email form -->
                <div>
                    <label class="text-[10px] uppercase font-bold text-slate-400 block mb-1.5 font-mono">Địa chỉ Email</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                            <i data-lucide="mail" class="w-4 h-4"></i>
                        </span>
                        <input
                            type="email"
                            disabled
                            value="@profile.Email"
                            class="w-full pl-9 pr-3.5 py-2.5 bg-slate-50 dark:bg-slate-950/40 text-slate-400 rounded-xl border border-slate-200 dark:border-slate-800 text-sm focus:outline-none font-sans cursor-not-allowed"
                        />
                    </div>
                    <p class="text-[10px] text-slate-400 mt-1 leading-normal font-sans">
                        Để bảo mật, không được sửa đổi địa chỉ email đăng nhập. Liên hệ hỗ trợ viên nếu đổi thiết bị học.
                    </p>
                </div>

                <hr class="border-slate-100 dark:border-slate-800/80 my-2" />

                <!-- Custom Settings Preferences: Level selecting & accent -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] uppercase font-bold text-slate-400 block mb-1.5 font-mono">Khóa học / Chủ đề mong muốn (Miễn phí)</label>
                        <select id="profile-level" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl py-2.5 px-3 focus:outline-none text-xs text-slate-700 dark:text-slate-350">
                            <option value="Casual" selected="@(profile.Level == UserLevel.Casual)">Casual Speaking (Đời sống)</option>
                            <option value="Academic" selected="@(profile.Level == UserLevel.Academic)">Academic Prep (Học thuật)</option>
                            <option value="Professional" selected="@(profile.Level == UserLevel.Professional)">Professional Career (Công việc)</option>
                        </select>
                    </div>

                    <div>
                        <label class="text-[10px] uppercase font-bold text-slate-400 block mb-1.5 font-mono">Mục tiêu điểm số trôi chảy</label>
                        <select id="profile-goal" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl py-2.5 px-3 focus:outline-none text-xs text-slate-700 dark:text-slate-355">
                            <option value="fluency50" selected="@(profile.Goal == LearningGoal.Fluency50)">Ưu tiên trôi chảy tự nhiên (&gt; 50%)</option>
                            <option value="comprehension70" selected="@(profile.Goal == LearningGoal.Comprehension70)">Làm việc tự tin người khác hiểu (&gt; 70%)</option>
                            <option value="accent90" selected="@(profile.Goal == LearningGoal.Accent90)">Phát âm chuẩn xác bản xứ (&gt; 90%)</option>
                        </select>
                    </div>
                </div>

                <!-- Accent selection - US vs UK -->
                <div>
                    <label class="text-[10px] uppercase font-bold text-slate-400 block mb-2 font-mono">Giọng phát âm mục tiêu (Target Accent)</label>
                    <div class="grid grid-cols-2 gap-3.5">
                        <button
                            type="button"
                            onclick="setTargetAccent('US')"
                            id="accent-btn-us"
                            class="py-2.5 rounded-xl border text-xs font-bold transition-all cursor-pointer @(profile.TargetAccent == TargetAccent.US ? "border-indigo-600 bg-indigo-50/15 text-indigo-600 dark:border-sky-400 dark:text-sky-400" : "border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300")"
                        >
                            🇺🇸 Giọng Mỹ (General American)
                        </button>
                        <button
                            type="button"
                            onclick="setTargetAccent('UK')"
                            id="accent-btn-uk"
                            class="py-2.5 rounded-xl border text-xs font-bold transition-all cursor-pointer @(profile.TargetAccent == TargetAccent.UK ? "border-indigo-600 bg-indigo-50/15 text-indigo-600 dark:border-sky-400 dark:text-sky-400" : "border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300")"
                        >
                            🇬🇧 Giọng Anh (RP / British)
                        </button>
                    </div>
                </div>

                <div id="save-success-banner" class="p-3 bg-emerald-50 text-emerald-800 border border-emerald-200/50 rounded-xl flex items-center gap-2 font-medium hidden">
                    <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-500"></i>
                    <span>Đã lưu thành công mọi cấu hình học tập và hồ sơ!</span>
                </div>

                <button
                    type="submit"
                    class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 dark:bg-sky-500 dark:hover:bg-sky-600 text-white rounded-xl font-bold flex items-center justify-center gap-2 cursor-pointer shadow-sm ml-auto"
                >
                    <i data-lucide="save" class="w-4 h-4"></i>
                    <span>Lưu Cấu Hình Hồ Sơ</span>
                </button>

            </form>

        </div>

        <!-- Right column: Action widgets on pricing & instructions - 4 cols -->
        <div class="md:col-span-4 space-y-6">
          
            <!-- VIP Upgrade simulation panel -->
            <div class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-3xl p-6 shadow-sm">
                <div class="flex items-center gap-2 text-indigo-600 dark:text-sky-400 mb-2">
                    <i data-lucide="sparkles" class="w-5 h-5 fill-indigo-500 text-indigo-500 dark:fill-none"></i>
                    <h4 class="font-extrabold text-slate-900 dark:text-slate-50 text-sm tracking-tight font-sans">Thành viên Pro VIP</h4>
                </div>
                
                @if (profile.IsPremium)
                {
                    <div id="vip-status-active" class="space-y-3.5 pt-2">
                        <div class="p-3.5 bg-emerald-50 text-emerald-800 dark:bg-emerald-500/5 dark:text-emerald-400 border border-emerald-200/50 dark:border-emerald-500/10 rounded-2xl flex gap-2 w-full text-xs items-start font-sans">
                            <i data-lucide="badge-check" class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5"></i>
                            <div>
                                <span class="font-extrabold text-xs block">Tài khoản PRO kích hoạt</span>
                                <span class="text-[10px] text-slate-400 leading-normal block mt-1">
                                    Phương thức nạp: VietQR / Credit Card (Simulated)
                                </span>
                            </div>
                        </div>

                        <button
                            type="button"
                            onclick="cancelVip()"
                            class="w-full py-2 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 font-bold text-[10px] text-slate-455 text-center rounded-xl cursor-pointer"
                        >
                            Hủy kích hoạt gói VIP
                        </button>
                    </div>
                }
                else
                {
                    <div id="vip-status-inactive" class="space-y-4 pt-2 font-sans text-xs">
                        <p class="text-slate-500 dark:text-slate-400 text-xs leading-normal">
                            Bạn đang sử dụng gói Miễn phí. Giới hạn số tim trong ngày, không cho phép thay đổi ngẫu nhiên bài giảng bằng AI.
                        </p>

                        <button
                            type="button"
                            onclick="openBillingModal()"
                            class="w-full py-3 bg-gradient-to-tr from-pink-500 to-indigo-600 text-white rounded-xl font-bold flex items-center justify-center gap-1.5 shadow-md hover:scale-[1.02] cursor-pointer"
                        >
                            <i data-lucide="credit-card" class="w-4 h-4 text-amber-200"></i>
                            <span>Nâng cấp VIP (Simulate)</span>
                        </button>
                    </div>
                }
            </div>

            <!-- Theme switcher panel inside settings -->
            <div class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-3xl p-6 shadow-sm text-xs">
                <h4 class="font-bold tracking-tight mb-2 flex items-center gap-1 text-slate-800 dark:text-slate-100 font-sans">
                    <i data-lucide="info" class="w-4 h-4 text-indigo-500"></i>
                    <span>Giao diện ứng dụng</span>
                </h4>
                <p class="text-slate-400 block leading-normal mb-3 font-sans">Ấn chuyển đổi giao diện sáng hoặc tối bảo vệ mắt người đọc buổi tối.</p>
                <button
                    type="button"
                    onclick="toggleTheme()"
                    class="w-full py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 flex items-center justify-center gap-2 font-bold cursor-pointer dark:text-white font-sans"
                >
                    <span class="dark:hidden flex items-center gap-2">
                        <i data-lucide="moon" class="w-4 h-4 text-indigo-500"></i>
                        <span>Kích hoạt giao diện Tối</span>
                    </span>
                    <span class="hidden dark:flex items-center gap-2">
                        <i data-lucide="sun" class="w-4 h-4 text-amber-500"></i>
                        <span>Kích hoạt giao diện Sáng</span>
                    </span>
                </button>
            </div>

            <!-- Logout Section -->
            <div class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-3xl p-6 shadow-sm text-xs">
                <h4 class="font-bold tracking-tight mb-2 flex items-center gap-1 text-rose-500 font-sans">
                    <i data-lucide="shield-alert" class="w-4 h-4"></i>
                    <span>Đăng xuất tài khoản</span>
                </h4>
                <p class="text-slate-400 block leading-normal mb-3 font-sans">Đăng xuất khỏi thiết bị này để bảo mật dữ liệu học tập cá nhân.</p>
                <a asp-controller="Home" asp-action="Auth"
                   class="w-full py-2.5 rounded-xl border border-rose-200 hover:bg-rose-50 dark:border-rose-950 dark:hover:bg-rose-950/20 text-rose-600 dark:text-rose-400 flex items-center justify-center gap-2 font-bold cursor-pointer transition-colors no-underline font-sans"
                   onclick="return confirm('Bạn có chắc chắn muốn đăng xuất khỏi ứng dụng không?')">
                    <i data-lucide="log-out" class="w-4 h-4"></i>
                    <span>Đăng xuất ngay</span>
                </a>
            </div>

        </div>

    </div>

    <!-- RENDER MOCK SUBSCRIPTION BILLING POPUP MODAL -->
    <div id="billing-modal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4 hidden">
        <div class="bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 w-full max-w-md rounded-3xl p-6 shadow-2xl relative font-sans">
            
            <button
              onclick="closeBillingModal()"
              class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-sm font-bold p-1 cursor-pointer"
            >
              ✕
            </button>

            <div class="text-center mb-5 font-sans">
                <span class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-sky-400 flex items-center justify-center mx-auto mb-3">
                    <i data-lucide="credit-card" class="w-6 h-6"></i>
                </span>
                <h3 class="font-black text-lg tracking-tight dark:text-white">Cổng thanh toán giả định</h3>
                <p class="text-slate-400 text-xxs mt-1">ShadowSpeak Subscription Billing Simulator - 100% Free</p>
            </div>

            <div class="space-y-4 font-sans text-xs">
              
                <div class="p-3.5 bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-2xl flex justify-between items-center text-xs">
                    <div>
                        <span class="font-bold text-xs dark:text-white">Nâng cấp gói thành viên VIP</span>
                        <p class="text-[10px] text-slate-400 mt-0.5">Sinh ngẫu nhiên bài giảng AI không giới hạn</p>
                    </div>
                    <strong class="text-sm font-extrabold text-indigo-600 dark:text-sky-400">149.000 ₫</strong>
                </div>

                <div>
                    <label class="text-[9px] font-bold text-slate-400 block mb-1">MÃ SỐ THẺ ĐĂNG KÝ (VISA SIMULATED)</label>
                    <input
                      type="text"
                      id="card-number-input"
                      value="4111 2222 3333 4444"
                      class="w-full bg-slate-50 dark:bg-slate-900 p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-xs font-mono tracking-wider focus:outline-none focus:border-indigo-500 dark:text-white"
                    />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-[9px] font-bold text-slate-400 block mb-1">NGÀY HẾT HẠN</label>
                        <input
                          type="text"
                          value="12/29"
                          class="w-full bg-slate-50 dark:bg-slate-900 p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-xs text-center dark:text-white"
                        />
                    </div>
                    <div>
                        <label class="text-[9px] font-bold text-slate-400 block mb-1">MÃ BẢO MẬT (CVV)</label>
                        <input
                          type="password"
                          value="123"
                          class="w-full bg-slate-50 dark:bg-slate-900 p-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-xs text-center dark:text-white"
                        />
                    </div>
                </div>

                <div class="bg-emerald-50 dark:bg-emerald-500/5 text-emerald-800 dark:text-emerald-400 p-3 rounded-xl border border-emerald-200/50 dark:border-emerald-500/10 flex gap-2 items-start mt-4">
                    <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5"></i>
                    <p class="text-[10px] leading-normal font-sans text-emerald-700 dark:text-emerald-400">
                        <strong>An toàn tuyệt đối:</strong> Đây hoàn toàn là một giao dịch giả lập. Tài khoản của bạn sẽ được kích hoạt quyền thành viên Pro VIP lập tức mà không phát sinh phí thật nào cả!
                    </p>
                </div>

                <button
                    type="button"
                    onclick="handleSimulateSubscriptionCharge()"
                    class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl flex items-center justify-center gap-1.5 tracking-wide shadow cursor-pointer mt-5"
                >
                    <span>XÁC NHẬN NẠP TIỀN 149.000₫</span>
                </button>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        var activeAccent = "@profile.TargetAccent.ToString()";

        function setTargetAccent(accent) {
            activeAccent = accent;
            var usBtn = document.getElementById("accent-btn-us");
            var ukBtn = document.getElementById("accent-btn-uk");

            if (accent === 'US') {
                usBtn.className = "py-2.5 rounded-xl border text-xs font-bold transition-all cursor-pointer border-indigo-600 bg-indigo-50/15 text-indigo-600 dark:border-sky-400 dark:text-sky-400";
                ukBtn.className = "py-2.5 rounded-xl border text-xs font-bold transition-all cursor-pointer border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300";
            } else {
                ukBtn.className = "py-2.5 rounded-xl border text-xs font-bold transition-all cursor-pointer border-indigo-600 bg-indigo-50/15 text-indigo-600 dark:border-sky-400 dark:text-sky-400";
                usBtn.className = "py-2.5 rounded-xl border text-xs font-bold transition-all cursor-pointer border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300";
            }
        }

        function handleSaveProfileSubmit(event) {
            event.preventDefault();
            var banner = document.getElementById("save-success-banner");
            banner.classList.remove("hidden");
            setTimeout(function() {
                banner.classList.add("hidden");
            }, 2500);
        }

        function openBillingModal() {
            document.getElementById("billing-modal").classList.remove("hidden");
        }

        function closeBillingModal() {
            document.getElementById("billing-modal").classList.add("hidden");
        }

        function handleSimulateSubscriptionCharge() {
            closeBillingModal();
            alert('Thanh toán giả định thành công! Tài khoản Nguyễn Văn A hiện là thành viên Pro VIP vô hạn.');
            // Reload page or update UI locally
            location.reload();
        }

        function cancelVip() {
            alert('Hủy Pro VIP thành công. Trải nghiệm gói thường!');
            location.reload();
        }
    </script>
}
