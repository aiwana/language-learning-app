@model WebShadowing.Models.LessonPageViewModel
@using WebShadowing.Models
@{
    ViewData["Title"] = Model.Title;
    var profile = ViewBag.UserProfile as UserProfile ?? StaticData.DefaultProfile;
    var stats = ViewBag.UserStats as UserStats ?? StaticData.DefaultStats;
}

<div id="lesson-view-container" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 animate-slide-up">

      <!-- Top controls and headers bar -->
      <div class="flex items-center justify-between mb-5">
        <a asp-action="Index"
          class="flex items-center gap-2 text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-sky-400 font-sans font-bold text-xs cursor-pointer bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800/80 px-3 py-1.5 rounded-xl shadow-sm no-underline"
        >
          <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
          <span>Quay lại Thư Viện</span>
        </a>

        <span class="text-[10px] text-slate-400 font-mono bg-slate-100 dark:bg-slate-800/60 px-2.5 py-1 rounded-md">
          CHỦ ĐỀ: <span class="font-bold text-indigo-600 dark:text-sky-400">@Model.Topic.ToUpper()</span> • <span class="font-semibold text-slate-500">@Model.Level</span>
        </span>
      </div>

      <!-- Primary High Density 2-Column Grid -->
      <div class="grid lg:grid-cols-12 gap-6 items-start">

        <!-- LEFT COLUMN: Training Dashboard & Content Modules (8 Cols) -->
        <div id="lesson-left-column" class="lg:col-span-8 space-y-6">

          <div class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800/80 rounded-2xl p-5 md:p-6 shadow-sm relative overflow-hidden">

            <div class="absolute left-0 top-0 bottom-0 w-1 bg-indigo-600 dark:bg-sky-500"></div>

            <!-- Lesson Title Banner -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-slate-50 dark:border-slate-800/60 pb-4 mb-5 gap-4">
              <div>
                <span class="text-[9px] bg-indigo-50 text-indigo-700 dark:bg-sky-500/10 dark:text-sky-400 px-2 py-0.5 rounded uppercase font-mono font-bold tracking-wider">
                  Khóa Học Tiếng Anh Shadowing
                </span>
                <h2 class="text-lg md:text-xl font-sans font-extrabold tracking-tight text-slate-900 dark:text-slate-100 mt-1">
                  @Model.Title
                </h2>
              </div>

              <div class="flex items-center gap-2">
                @if (Model.IsGenerated == true)
                {
                  <button
                    onclick="handleSaveAILesson()"
                    id="save-ai-btn"
                    class="px-2.5 py-1.5 rounded-lg border flex items-center gap-1.5 transition-all text-[11px] font-bold cursor-pointer shrink-0 border-pink-200 bg-pink-50 text-pink-600 hover:bg-pink-100 dark:border-pink-850 dark:bg-pink-950/10 dark:text-pink-400"
                  >
                    <i data-lucide="sparkles" class="w-3.5 h-3.5 fill-current"></i>
                    <span id="save-ai-text">Lưu bài AI</span>
                  </button>
                }

                <button
                  onclick="handleBookmarkSentence()"
                  class="px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/60 text-slate-500 hover:text-indigo-600 flex items-center gap-1.5 transition-all text-[11px] font-bold cursor-pointer shrink-0"
                >
                  <i data-lucide="bookmark" class="w-3.5 h-3.5 text-indigo-650 dark:text-sky-400"></i>
                  <span>Bookmark câu này</span>
                </button>
              </div>
            </div>

            <!-- Modular Tab Headers -->
            <div class="flex border-b border-slate-100 dark:border-slate-800/40 mb-5 font-sans text-xs overflow-x-auto">
              <button
                id="tab-shadowing"
                onclick="switchTab('shadowing')"
                class="px-3 py-2 font-extrabold pb-2 border-b-2 cursor-pointer transition-colors whitespace-nowrap border-indigo-600 text-indigo-600 dark:border-sky-400 dark:text-sky-400"
              >
                Studio Shadowing
              </button>
              <button
                id="tab-roleplay"
                onclick="switchTab('roleplay')"
                class="px-3 py-2 font-extrabold pb-2 border-b-2 cursor-pointer transition-colors whitespace-nowrap border-transparent text-slate-400 hover:text-slate-600"
              >
                Đàm thoại Role Play AI
              </button>
              <button
                id="tab-dictation"
                onclick="switchTab('dictation')"
                class="px-3 py-2 font-extrabold pb-2 border-b-2 cursor-pointer transition-colors whitespace-nowrap border-transparent text-slate-400 hover:text-slate-600"
              >
                Nghe & Chép Chính Tả
              </button>
              <button
                id="tab-ipagame"
                onclick="switchTab('ipa-game')"
                class="px-3 py-2 font-extrabold pb-2 border-b-2 cursor-pointer transition-colors whitespace-nowrap border-transparent text-slate-400 hover:text-slate-600"
              >
                Thử thách cặp IPA
              </button>
            </div>

            <!-- TAB CONTENT: CORE SHADOWING STUDIO -->
            <div id="panel-shadowing" class="tab-panel space-y-5">

              <div class="active-sentence p-5 md:p-6 rounded-xl border border-indigo-100/50 dark:border-sky-500/10 shadow-sm text-center space-y-3.5">

                <!-- Video embed for Video Bank lessons -->
                @if (!string.IsNullOrEmpty(Model.YoutubeId))
                {
                  <div id="lesson-video-player" class="mb-5 aspect-video w-full max-w-2xl mx-auto rounded-2xl overflow-hidden bg-black border border-slate-200 dark:border-slate-800/80 shadow-md">
                    <div id="youtube-player" class="w-full h-full"></div>
                  </div>
                }

                <!-- Target Phrase with Inline IPA and Click-to-Translate -->
                <div id="words-container" class="ipa-word-grid my-4 select-none justify-center">
                    <!-- Word cells injected by JS -->
                </div>

                <!-- Target Vietnamese translation -->
                <div id="target-translation" class="font-sans text-slate-500 dark:text-slate-400 text-xs md:text-sm font-semibold italic mt-2">
                    <!-- Translation injected by JS -->
                </div>

                <!-- Word Correction details panel -->
                <div id="word-correction-panel" class="mt-3 p-3.5 bg-yellow-400/5 dark:bg-yellow-400/10 border border-yellow-200/50 rounded-xl max-w-md mx-auto text-left flex gap-3 text-[11px] leading-normal animate-slide-up hidden">
                  <div class="w-5 h-5 rounded-full bg-yellow-400/20 text-yellow-600 dark:text-yellow-400 flex items-center justify-center shrink-0 font-bold font-mono text-[10px]">!</div>
                  <div class="flex-1">
                    <h4 class="font-bold text-slate-900 dark:text-slate-50 flex items-center gap-1.5">
                      Phát âm từ: <span id="correcting-word-name" class="text-indigo-650 dark:text-sky-400 font-mono text-xs">""</span>
                      <span id="correcting-word-badge" class="text-[10px] text-slate-400 font-normal">()</span>
                    </h4>
                    <p id="correcting-word-ipa" class="text-[10px] font-mono mt-0.5 text-slate-400"></p>
                    <p id="correcting-word-tip" class="text-slate-500 mt-1 dark:text-slate-350 font-sans leading-relaxed"></p>
                  </div>
                </div>

              </div>

              <!-- Simulated Audio Stream Control Line with waveform -->
              <div class="flex justify-between items-center bg-slate-50 dark:bg-slate-950/20 rounded-xl p-3 border border-slate-100 dark:border-slate-800 gap-4">
                <div class="flex items-center gap-3">
                  <button
                    onclick="playTargetAudio()"
                    class="w-10 h-10 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg shadow-sm flex items-center justify-center transition-all cursor-pointer"
                    title="Nghe giọng đọc chuẩn bản xứ"
                  >
                    <i data-lucide="volume-2" class="w-4.5 h-4.5"></i>
                  </button>
                  <div class="text-left font-sans">
                    <p class="text-[11px] font-bold text-slate-700 dark:text-slate-200">Listening Mode (Nghe âm chuẩn)</p>
                    <p class="text-[10px] text-slate-400">Nghe máy học phát âm nhấn ngắt nhịp tự nhiên.</p>
                  </div>
                </div>

                <div class="h-6 flex items-center gap-1 shrink-0 px-2 bg-white dark:bg-slate-950 border border-slate-100 dark:border-slate-900 rounded-md py-1">
                  <!-- Waveform bars -->
                  <span class="inline-block w-[2.5px] rounded-full h-1.5 opacity-30 bg-indigo-500 dark:bg-sky-400 wave-bar-element"></span>
                  <span class="inline-block w-[2.5px] rounded-full h-3 opacity-30 bg-indigo-500 dark:bg-sky-400 wave-bar-element"></span>
                  <span class="inline-block w-[2.5px] rounded-full h-2 opacity-30 bg-indigo-500 dark:bg-sky-400 wave-bar-element"></span>
                  <span class="inline-block w-[2.5px] rounded-full h-4 opacity-30 bg-indigo-500 dark:bg-sky-400 wave-bar-element"></span>
                  <span class="inline-block w-[2.5px] rounded-full h-1.5 opacity-30 bg-indigo-500 dark:bg-sky-400 wave-bar-element"></span>
                  <span class="inline-block w-[2.5px] rounded-full h-3 opacity-30 bg-indigo-500 dark:bg-sky-400 wave-bar-element"></span>
                  <span class="inline-block w-[2.5px] rounded-full h-2.5 opacity-30 bg-indigo-500 dark:bg-sky-400 wave-bar-element"></span>
                  <span class="inline-block w-[2.5px] rounded-full h-4.5 opacity-30 bg-indigo-500 dark:bg-sky-400 wave-bar-element"></span>
                  <span class="inline-block w-[2.5px] rounded-full h-2 opacity-30 bg-indigo-500 dark:bg-sky-400 wave-bar-element"></span>
                  <span class="inline-block w-[2.5px] rounded-full h-3.5 opacity-30 bg-indigo-500 dark:bg-sky-400 wave-bar-element"></span>
                  <span class="inline-block w-[2.5px] rounded-full h-1 opacity-30 bg-indigo-500 dark:bg-sky-400 wave-bar-element"></span>
                  <span class="inline-block w-[2.5px] rounded-full h-3 opacity-30 bg-indigo-500 dark:bg-sky-400 wave-bar-element"></span>
                </div>
              </div>

              <!-- Local Client Device Recording Engine Interface -->
              <div class="bg-slate-50/50 dark:bg-slate-950/20 border border-slate-100 dark:border-slate-800 rounded-xl p-4 flex flex-col justify-between">
                <div>
                  <h4 class="text-[9px] font-extrabold text-slate-400 uppercase tracking-widest block mb-1">Thiết bị thu âm</h4>

                  <div id="recording-status-box">
                    <p class="text-[10px] text-slate-400 mt-0.5">Micro sẵn sàng. Nhấp nút xanh bên dưới để ghi âm nhại tiếng.</p>
                  </div>

                  <div class="mt-3 p-3 bg-white dark:bg-slate-950/90 border border-slate-200/60 dark:border-slate-800 rounded-lg min-h-[60px] max-h-[100px] overflow-y-auto text-xs font-bold text-slate-800 dark:text-slate-100 font-sans leading-relaxed relative">
                    <span id="transcription-output-text" class="text-slate-400 italic font-normal text-[11px]">Văn bản STT thực tế tương tác sẽ khớp tại đây...</span>
                  </div>

                  <div id="recognition-error-box" class="hidden">
                    <p class="text-[9px] text-rose-500 mt-1.5 flex items-center gap-1 leading-normal">
                      <i data-lucide="alert-circle" class="w-3 h-3 text-rose-500 shrink-0"></i>
                      <span id="recognition-error-text"></span>
                    </p>
                  </div>
                </div>

                <div class="flex items-center gap-2 mt-4">
                  <button
                    id="record-toggle-btn"
                    onclick="handleToggleRecording()"
                    class="px-4 py-2.5 rounded-lg font-bold font-sans text-xs flex items-center gap-2 cursor-pointer transition-all bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm"
                  >
                    <i data-lucide="mic" class="w-3.5 h-3.5 text-white" id="mic-icon-stt"></i>
                    <span id="record-btn-text">BẮT ĐẦU THU ÂM</span>
                  </button>

                  <button
                    id="clear-record-btn"
                    onclick="clearRecording()"
                    class="px-3 py-2.5 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 font-bold text-[11px] cursor-pointer hidden"
                  >
                    Xóa Thu Âm
                  </button>

                  <button
                    id="simulate-mic-btn"
                    onclick="simulateMicrophoneInput()"
                    class="px-3 py-2.5 rounded-lg border border-dashed border-indigo-200 text-indigo-500 hover:bg-indigo-50 dark:border-slate-850 dark:text-sky-400 dark:hover:bg-slate-800 font-bold text-[11px] cursor-pointer flex items-center gap-1"
                    title="Dành cho trình duyệt không hỗ trợ micro/chưa cấp quyền"
                  >
                    <i data-lucide="sparkles" class="w-3 h-3 text-indigo-500 dark:text-sky-400"></i>
                    Ghi âm giả lập
                  </button>
                </div>
              </div>

            </div>

            <!-- TAB CONTENT: INTERACTIVE AI ROLE PLAY MODE -->
            <div id="panel-roleplay" class="tab-panel space-y-6 hidden">
              <div id="roleplay-loader" class="py-12 flex flex-col justify-center items-center text-center hidden">
                <i data-lucide="refresh-cw" class="w-8 h-8 text-indigo-600 animate-spin mb-3"></i>
                <p class="text-slate-400 text-xs font-medium">Đang khởi tạo đàm thoại Role Play với Gemini AI...</p>
              </div>

              <div id="roleplay-content" class="space-y-5">
                <!-- Role Selection Grid -->
                <div class="p-4 bg-slate-50 dark:bg-slate-950/45 rounded-2xl border border-slate-100 dark:border-slate-800/80 font-sans">
                  <span class="text-[9px] uppercase font-bold tracking-widest text-slate-400 block mb-2">Chọn vai đàm thoại của bạn</span>
                  <div id="role-selection-container" class="flex flex-wrap gap-2">
                    <!-- Role buttons injected by JS -->
                  </div>
                </div>

                <!-- Chat Log Message bubbles -->
                <div id="chat-bubbles-container" class="chat-container border border-slate-100 dark:border-slate-800/60 rounded-2xl bg-slate-50/50 dark:bg-slate-950/20 max-h-[350px] overflow-y-auto">
                    <!-- Chat bubbles injected by JS -->
                </div>

                <!-- Chat Input Bar & Controls -->
                <div id="roleplay-controls-container" class="space-y-3">
                    <!-- Controls injected by JS -->
                </div>

                <!-- SCRIPT REFERENCE DRAWER -->
                <div class="mt-8 border-t border-slate-100 dark:border-slate-800 pt-6">
                  <details class="group">
                    <summary class="flex justify-between items-center font-sans font-extrabold text-xs text-slate-500 hover:text-slate-700 cursor-pointer select-none">
                      <span class="flex items-center gap-1.5">
                        <i data-lucide="book-open" class="w-4 h-4 text-indigo-500"></i>
                        KỊCH BẢN ĐÀM THOẠI TOÀN BỘ (SCRIPT REFERENCE)
                      </span>
                      <span class="transition-transform group-open:rotate-180">
                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                      </span>
                    </summary>
                    <div id="roleplay-script-reference" class="mt-4 space-y-4 font-sans text-xs bg-slate-50 dark:bg-slate-950 p-4 rounded-2xl border border-slate-150 dark:border-slate-850">
                      <!-- Full dialogue scripts injected by JS -->
                    </div>
                  </details>
                </div>
              </div>
            </div>

            <!-- TAB CONTENT: DICTATION SPELLING GAME -->
            <div id="panel-dictation" class="tab-panel space-y-4 hidden">
              <div class="p-4 bg-indigo-50/20 dark:bg-slate-950/40 rounded-xl border border-indigo-100/10 text-center font-sans">
                <span class="text-[9px] uppercase font-bold tracking-widest text-indigo-600 dark:text-sky-400 block mb-1">Phương pháp Dictation</span>
                <h3 class="font-extrabold text-xs text-slate-800 dark:text-slate-200">Gõ lại đúng những gì bạn nghe thấy</h3>

                <button
                  type="button"
                  onclick="playTargetAudio()"
                  class="mt-3 mx-auto w-10 h-10 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white flex items-center justify-center cursor-pointer transition-all hover:scale-105 shadow"
                  title="Nghe câu mẫu"
                >
                  <i data-lucide="volume-2" class="w-4.5 h-4.5"></i>
                </button>
              </div>

              <div class="space-y-3 font-sans text-xs">
                <div>
                  <label class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block mb-1">NHẬP VĂN BẢN CHÍNH TẢ</label>
                  <textarea
                    id="dictation-textarea"
                    oninput="handleDictationInput(event)"
                    rows="2"
                    class="w-full bg-slate-50 dark:bg-slate-950 p-3 rounded-lg border border-slate-200 dark:border-slate-800 font-sans tracking-wide leading-relaxed text-xs focus:outline-none focus:border-indigo-500"
                    placeholder="Nghe, dịch rồi gõ lại chuẩn xác từng từ..."
                  ></textarea>
                </div>

                <div id="dictation-result-box" class="hidden">
                    <!-- Spelling feedback box injected by JS -->
                </div>

                <div class="flex gap-2">
                  <button
                    type="button"
                    id="dictation-check-btn"
                    onclick="checkDictationSpelling()"
                    class="px-4 py-2 rounded-lg font-bold flex items-center justify-center gap-1.5 transition-all text-xs cursor-pointer bg-slate-100 text-slate-400 cursor-not-allowed dark:bg-slate-800 dark:text-slate-600"
                    disabled
                  >
                    <i data-lucide="keyboard" class="w-3.5 h-3.5"></i>
                    <span>Kết quả chép</span>
                  </button>

                  <button
                    type="button"
                    id="dictation-retry-btn"
                    onclick="resetDictationSpelling()"
                    class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 font-bold text-xs cursor-pointer hidden"
                  >
                    Thử lại
                  </button>
                </div>
              </div>
            </div>

            <!-- TAB CONTENT: IPA MATCHING GAME -->
            <div id="panel-ipa-game" class="tab-panel space-y-4 hidden">
              <div class="p-4 bg-amber-50/20 dark:bg-slate-950/40 rounded-xl border border-amber-100/15 text-center font-sans">
                <span class="text-[9px] uppercase font-bold tracking-widest text-amber-600 dark:text-amber-400 block mb-1">IPA Challenge Game</span>
                <p class="text-[11px] text-slate-400 max-w-sm mx-auto leading-normal">
                  Ký tự phiên âm bên dưới thuộc về từ nào trong số các lựa chọn này?
                </p>

                <div id="ipa-quiz-text" class="mt-3 text-lg font-mono text-indigo-600 dark:text-sky-400 font-extrabold tracking-wider p-2 bg-white dark:bg-slate-950 border border-slate-100 dark:border-slate-800/80 inline-block rounded-lg shadow-sm">
                    <!-- IPA tag injected by JS -->
                </div>
              </div>

              <div class="space-y-3 font-sans">
                <div id="ipa-options-grid" class="grid grid-cols-2 gap-3">
                  <!-- 2x2 grid injected by JS -->
                </div>

                <div id="ipa-feedback-box" class="hidden">
                    <!-- Correct/Incorrect warning box injected by JS -->
                </div>

                <button
                  id="ipa-next-btn"
                  onclick="advanceIpaQuizSentence()"
                  class="py-1.5 px-3.5 bg-indigo-600 text-white rounded-lg text-[11px] font-bold hover:bg-indigo-700 cursor-pointer hidden"
                >
                  Sang câu hỏi sau
                </button>
              </div>
            </div>

          </div>

          <!-- SUBTITLE LIST PANEL -->
          <div id="panel-subtitles-drawer" class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800/80 rounded-2xl p-4 md:p-5 shadow-sm">
            <h4 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest block mb-3">Tài liệu phụ đề bài giảng (<span id="subtitles-count-label">0</span> Câu)</h4>

            <div id="subtitles-list-container" class="space-y-2 max-h-64 md:max-h-80 overflow-y-auto overscroll-contain">
              <!-- Rendered list of sentences -->
            </div>

            <div class="mt-4 pt-4 border-t border-slate-50 dark:border-slate-800/80 flex justify-between items-center gap-4 text-[11px] font-sans text-slate-400">
              <p>Mục tiêu: Đọc chính xác &gt; 80 EXP</p>
              <button
                onclick="advanceActiveSentence()"
                class="py-1.5 px-3 bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 rounded-lg hover:bg-slate-200 transition-colors font-bold cursor-pointer shrink-0"
              >
                Câu Kế Tiếp (<span id="subtitle-progress-label">1/1</span>)
              </button>
            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN: EVALUATION ANALYTICS CARD & COACH PRO TIPS (4 Cols) -->
        <div class="lg:col-span-4 space-y-6">

          <!-- Circular overall score chart HUD -->
          <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-100 dark:border-slate-800/80 shadow-sm text-center relative overflow-hidden">
            <h3 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest text-left mb-4">Điểm Số Đánh Giá AI</h3>

            <div class="relative w-32 h-32 mx-auto mb-4">
              <svg class="w-32 h-32 transform -rotate-90">
                <circle
                  cx="64"
                  cy="64"
                  r="52"
                  fill="none"
                  strokeWidth="11"
                  class="stroke-slate-100 dark:stroke-slate-800/60"
                />
                <circle
                  id="score-circle-ring"
                  cx="64"
                  cy="64"
                  r="52"
                  fill="none"
                  strokeWidth="11"
                  stroke="#e2e8f0"
                  strokeDasharray="326.7"
                  strokeDashoffset="326.7"
                  class="score-ring"
                />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center font-sans">
                <span id="hud-score-value" class="text-3xl font-black text-slate-900 dark:text-slate-50 tracking-tight">
                  85
                </span>
                <span id="hud-score-label" class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block mt-0.5">
                  Target Point
                </span>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2 mt-4 text-left">
              <div class="bg-slate-50 dark:bg-slate-950 p-2 rounded-xl border border-slate-100 dark:border-slate-800/60">
                <p class="text-[9px] text-slate-400 uppercase font-bold tracking-wider font-mono">Nhịp độ đọc</p>
                <p id="hud-pace-status" class="text-xs font-black text-slate-800 dark:text-slate-200 mt-0.5">
                  Chuẩn Bản Xứ
                </p>
              </div>
              <div class="bg-slate-50 dark:bg-slate-950 p-2 rounded-xl border border-slate-100 dark:border-slate-800/60">
                <p class="text-[9px] text-slate-400 uppercase font-bold tracking-wider font-mono">Dải tần cao độ</p>
                <p id="hud-pitch-status" class="text-xs font-black text-slate-800 dark:text-slate-200 mt-0.5">
                  Cân Bằng
                </p>
              </div>
            </div>
          </div>

          <!-- AI Pronunciation detailed Breakdown list -->
          <div class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800/80 rounded-2xl p-4 md:p-5 shadow-sm flex flex-col min-h-[280px]">
            <h3 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest mb-4">Chi Tiết Lỗi Phát Âm Từng Từ</h3>

            <div id="ai-evaluation-loading" class="flex-1 flex flex-col justify-center items-center py-10 text-center hidden">
              <div class="w-7 h-7 rounded-full border-2 border-indigo-600 border-t-transparent animate-spin mb-3"></div>
              <p class="text-[11px] text-slate-400 max-w-xs animate-pulse font-sans">
                AI đang xử lý cao độ, tách âm vị học, phát hiện các quãng ngắt nhịp thoại...
              </p>
            </div>

            <div id="ai-evaluation-list" class="space-y-3.5 flex-1 overflow-y-auto max-h-[220px] pr-1.5 hidden">
                <!-- Word breakdowns injected by JS -->
            </div>

            <div id="ai-evaluation-empty" class="flex-1 flex flex-col items-center justify-center text-center py-12">
              <i data-lucide="sparkles" class="w-7 h-7 text-slate-300 dark:text-slate-700 animate-bounce mb-3"></i>
              <p class="text-[10px] text-slate-400 max-w-xs font-sans leading-relaxed">
                Chưa có dữ liệu bài nói. Ghi âm bằng nút xanh góc trái rồi nhấp nút chấm điểm để xem phân tích.
              </p>
            </div>

            <div class="mt-4 p-3 bg-indigo-50/70 dark:bg-indigo-950/20 rounded-xl border border-indigo-100/40 dark:border-indigo-800/30 text-[11px] text-indigo-900 dark:text-indigo-300 leading-relaxed font-sans italic relative">
              <strong>Gemini Coach Pro Tip:</strong>
              <p id="gemini-coach-tip-text" class="mt-1">
                "Luyện nói đều đặn hằng ngày giúp rèn vùng cơ môi tự nhiên. Ấn nút Phát âm tiếng bản xứ rồi nói nhại ngay sau để giữ nhịp thở chuẩn."
              </p>
            </div>

            <div class="mt-4">
              <button
                id="evaluate-pronunciation-btn"
                onclick="evaluatePronunciation()"
                class="w-full py-2.5 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 cursor-not-allowed bg-slate-100 text-slate-400 dark:bg-slate-800/80 dark:text-slate-600"
                disabled
              >
                <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-300 fill-amber-300"></i>
                <span>CHẤM CÂU THOẠI VỚI AI</span>
              </button>
            </div>

          </div>

        </div>

      </div>

</div>

@section Scripts {
    @if (!string.IsNullOrEmpty(Model.YoutubeId))
    {
        <script src="https://www.youtube.com/iframe_api"></script>
    }
    <script>
        // 1. Raw Lesson Model injected from MVC
        const lesson = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        
        // 2. Global State holding page reactivity
        const state = {
            activeSentenceIndex: 0,
            activeTab: 'shadowing',
            isRecording: false,
            transcribedText: '',
            interimTranscript: '',
            recognitionError: null,
            isEvaluating: false,
            evaluation: null,
            selectedWord: null,

            // Dictation
            dictationInput: '',
            dictationChecked: false,
            dictationPassed: false,

            // IPA Quiz
            ipaQuizOptions: [],
            ipaQuizCorrect: '',
            ipaSelectedAnswer: null,
            ipaFeedbackMessage: null,

            // Tooltip dictionary lookup
            lookupKey: null,
            isLookingUp: false,
            wordMeaning: null,
            wordIpaCache: {},
            ipaFetchGeneration: 0,
            ipaLoading: false,
            videoSyncFromPlayer: false,

            // Stats (Sync with header DOM)
            expGained: @stats.Exp,
            heartsRemaining: @(profile.IsPremium ? 999 : stats.Hearts),
            isPremium: @(profile.IsPremium ? "true" : "false"),

            // Roleplay parameters
            rolePlayMessages: [],
            rolePlaySpeakers: [],
            selectedRole: null,
            isLoadingRolePlay: false,
            rolePlayActiveIndex: 0,
            isEvaluatingRolePlay: false,
            rolePlaySTTText: '',
            rolePlayInterimSTT: ''
        };

        // Speech recognition reference
        let recognition = null;
        let recordingSimTimer = null;
        let currentSessionId = null;
        let lessonAudioPlayer = null;
        let ytPlayer = null;
        let ytSyncTimer = null;
        let ytPlayerReady = false;
        const YT_STATE_PLAYING = 1;
        const YT_STATE_BUFFERING = 3;
        const youtubeVideoId = @Html.Raw(string.IsNullOrEmpty(Model.YoutubeId) ? "null" : $"\"{Model.YoutubeId}\"");

        function getSentenceStart(sentence) {
            return Number(sentence?.StartTime ?? sentence?.startTime ?? 0);
        }

        function getSentenceEnd(sentence) {
            return Number(sentence?.EndTime ?? sentence?.endTime ?? 0);
        }

        function formatVideoTime(seconds) {
            const total = Math.max(0, Math.floor(seconds));
            const minutes = Math.floor(total / 60);
            const secs = total % 60;
            return `${minutes}:${secs.toString().padStart(2, '0')}`;
        }

        function lessonHasVideoSync() {
            return lesson.Sentences.some(s => getSentenceStart(s) > 0);
        }

        function findSentenceIndexForTime(seconds) {
            if (!lesson.Sentences.length) return -1;

            const epsilon = 0.08;

            for (let i = 0; i < lesson.Sentences.length; i++) {
                const start = getSentenceStart(lesson.Sentences[i]);
                const end = getSentenceEnd(lesson.Sentences[i]);
                const rangeEnd = end > start
                    ? end
                    : (i + 1 < lesson.Sentences.length
                        ? getSentenceStart(lesson.Sentences[i + 1])
                        : start + 2);

                if (seconds + epsilon >= start && seconds < rangeEnd + epsilon) {
                    return i;
                }
            }

            let active = 0;
            for (let i = 0; i < lesson.Sentences.length; i++) {
                const start = getSentenceStart(lesson.Sentences[i]);
                if (seconds + epsilon >= start) {
                    active = i;
                } else {
                    break;
                }
            }
            return active;
        }

        function seekVideoToSentence(index, shouldPlay = true) {
            if (!ytPlayerReady || !ytPlayer || typeof ytPlayer.seekTo !== 'function') return;

            const sentence = lesson.Sentences[index];
            if (!sentence) return;

            const start = getSentenceStart(sentence);
            state.videoSyncFromPlayer = true;
            ytPlayer.seekTo(start, true);
            if (shouldPlay && typeof ytPlayer.playVideo === 'function') {
                ytPlayer.playVideo();
            }
            window.setTimeout(() => {
                state.videoSyncFromPlayer = false;
            }, 600);
        }

        function startYoutubeTimeSync() {
            if (!youtubeVideoId || !lessonHasVideoSync() || ytSyncTimer) return;

            ytSyncTimer = window.setInterval(() => {
                if (!ytPlayerReady || !ytPlayer || state.videoSyncFromPlayer) {
                    return;
                }

                if (typeof ytPlayer.getCurrentTime !== 'function') {
                    return;
                }

                let currentTime;
                try {
                    currentTime = ytPlayer.getCurrentTime();
                } catch {
                    return;
                }

                if (typeof currentTime !== 'number' || Number.isNaN(currentTime)) {
                    return;
                }

                const idx = findSentenceIndexForTime(currentTime);

                if (idx >= 0 && idx !== state.activeSentenceIndex) {
                    syncSentenceFromVideo(idx);
                }
            }, 250);
        }

        function initYouTubePlayer() {
            if (!youtubeVideoId || !document.getElementById('youtube-player')) return;

            const createPlayer = () => {
                if (ytPlayer) return;

                ytPlayer = new YT.Player('youtube-player', {
                    videoId: youtubeVideoId,
                    width: '100%',
                    height: '100%',
                    playerVars: {
                        rel: 0,
                        modestbranding: 1,
                        enablejsapi: 1,
                        origin: window.location.origin,
                        playsinline: 1
                    },
                    events: {
                        onReady: () => {
                            ytPlayerReady = true;
                            startYoutubeTimeSync();
                        },
                        onStateChange: (event) => {
                            if (event.data === YT_STATE_PLAYING || event.data === YT_STATE_BUFFERING) {
                                startYoutubeTimeSync();
                            }
                        }
                    }
                });
            };

            if (window.YT && window.YT.Player) {
                createPlayer();
            } else {
                const previousReady = window.onYouTubeIframeAPIReady;
                window.onYouTubeIframeAPIReady = () => {
                    if (typeof previousReady === 'function') {
                        previousReady();
                    }
                    createPlayer();
                };
            }
        }

        function ensureLessonSentences() {
            if (!lesson.Sentences) {
                lesson.Sentences = [];
            }
        }

        function startPracticeSession() {
            if (!lesson.LessonId || currentSessionId) return;
            fetch('/api/practice/start', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ lessonId: lesson.LessonId })
            })
            .then(res => {
                if (!res.ok) throw new Error("Start session failed");
                return res.json();
            })
            .then(data => {
                currentSessionId = data.sessionId;
                console.log("Practice session started ID:", currentSessionId);
            })
            .catch(err => console.error("Error starting practice:", err));
        }

        // Initialize elements
        document.addEventListener("DOMContentLoaded", () => {
            ensureLessonSentences();
            if (!lesson.Sentences.length) {
                document.getElementById("words-container").innerHTML =
                    '<p class="text-sm text-amber-600 dark:text-amber-400 font-semibold">Chưa có transcript. Thêm file script vào wwwroot/media và cập nhật Lesson_Material.</p>';
                document.getElementById("subtitles-count-label").textContent = '0';
                return;
            }
            initSpeechRecognition();
            initYouTubePlayer();
            loadActiveSentence();
            renderSubtitlesList();
            updateScoreCircleRing(85);
            
            // Add click listener outside to close tooltips
            document.addEventListener("click", () => {
                if (state.lookupKey) {
                    state.lookupKey = null;
                    renderActiveSentence();
                }
            });
        });

        // Speech recognition setup
        function initSpeechRecognition() {
            const SpeechReg = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (SpeechReg) {
                recognition = new SpeechReg();
                recognition.continuous = true;
                recognition.interimResults = true;
                recognition.lang = 'en-US';

                recognition.onstart = () => {
                    state.isRecording = true;
                    if (state.activeTab === 'roleplay') {
                        state.rolePlaySTTText = '';
                        state.rolePlayInterimSTT = '';
                    } else {
                        state.transcribedText = '';
                        state.interimTranscript = '';
                    }
                    state.recognitionError = null;
                    updateRecordingUI();
                };

                recognition.onresult = (event) => {
                    let interim = '';
                    let final = '';

                    for (let i = event.resultIndex; i < event.results.length; ++i) {
                        if (event.results[i].isFinal) {
                            final += event.results[i][0].transcript + ' ';
                        } else {
                            interim += event.results[i][0].transcript;
                        }
                    }

                    if (final) {
                        if (state.activeTab === 'roleplay') {
                            state.rolePlaySTTText += final;
                        } else {
                            state.transcribedText += final;
                        }
                    }

                    if (state.activeTab === 'roleplay') {
                        state.rolePlayInterimSTT = interim;
                    } else {
                        state.interimTranscript = interim;
                    }
                    updateRecordingTranscript();
                };

                recognition.onerror = (event) => {
                    console.error('Speech Recognition Error:', event);
                    if (event.error !== 'no-speech') {
                        state.recognitionError = `Microphone: ${event.error}. Vui lòng cấp quyền truy cập micro.`;
                        updateRecordingUI();
                    }
                };

                recognition.onend = () => {
                    state.isRecording = false;
                    updateRecordingUI();

                    // Auto-submit text when recording ends in Role Play mode
                    if (state.activeTab === 'roleplay') {
                        const transcript = (state.rolePlaySTTText + state.rolePlayInterimSTT).trim();
                        if (transcript) {
                            sendSpeechMessage(transcript);
                        }
                    }
                };
            } else {
                state.recognitionError = 'Trình duyệt không hỗ trợ trực tiếp Google Speech API. Khuyên dùng Google Chrome/Edge.';
                document.getElementById("recognition-error-box").classList.remove("hidden");
                document.getElementById("recognition-error-text").textContent = state.recognitionError;
            }
        }

        // Toggle record state
        function handleToggleRecording() {
            // Cancel simulator if running
            if (recordingSimTimer) {
                clearTimeout(recordingSimTimer);
                recordingSimTimer = null;
            }

            if (state.isRecording) {
                if (recognition) {
                    recognition.stop();
                } else {
                    state.isRecording = false;
                    updateRecordingUI();
                }
            } else {
                startPracticeSession();
                state.transcribedText = '';
                state.interimTranscript = '';
                state.rolePlaySTTText = '';
                state.rolePlayInterimSTT = '';
                state.evaluation = null;

                if (recognition) {
                    try {
                        recognition.start();
                    } catch (e) {
                        console.error("Failed to start speech recognition: ", e);
                    }
                } else {
                    state.isRecording = true;
                    updateRecordingUI();
                }
            }
        }

        // Simulating mic inputs for testing
        function simulateMicrophoneInput() {
            if (state.isRecording) {
                handleToggleRecording();
                return;
            }

            startPracticeSession();
            state.isRecording = true;
            state.transcribedText = '';
            state.interimTranscript = 'Đang nhận diện giọng nói giả lập...';
            state.evaluation = null;
            updateRecordingUI();
            updateRecordingTranscript();

            const target = getCurrentSentence().Text;
            
            recordingSimTimer = setTimeout(() => {
                // Return a transcription containing 90% accuracy (replace a word slightly or keep identical)
                const targetWords = target.split(' ');
                let resultText = target;
                if (targetWords.length > 3) {
                    // Slight spelling mutation for warning/incorrect testing
                    const lastIdx = targetWords.length - 1;
                    targetWords[lastIdx] = targetWords[lastIdx].toLowerCase().includes('day') ? 'days' : targetWords[lastIdx];
                    resultText = targetWords.join(' ');
                }

                state.transcribedText = resultText;
                state.interimTranscript = '';
                state.isRecording = false;
                
                updateRecordingUI();
                updateRecordingTranscript();
                
                // Alert simulation notice
                alert(`[GIẢ LẬP MICRO] Đã ghi âm thử thành công! Chuỗi ghi nhận: "${resultText}". Nhấn Chấm điểm để phân tích.`);
            }, 3000);
        }

        // Update mic button styles & visual waveforms
        function updateRecordingUI() {
            const btn = document.getElementById("record-toggle-btn");
            const btnText = document.getElementById("record-btn-text");
            const statusBox = document.getElementById("recording-status-box");
            const clearBtn = document.getElementById("clear-record-btn");
            const micIcon = document.getElementById("mic-icon-stt");

            // Waveform elements
            const waveBars = document.querySelectorAll(".wave-bar-element");

            if (state.isRecording) {
                btn.className = "px-4 py-2.5 rounded-lg font-bold font-sans text-xs flex items-center gap-2 cursor-pointer transition-all bg-rose-600 text-white animate-rec shadow-lg";
                btnText.textContent = "DỪNG THU";
                if (micIcon) micIcon.setAttribute("data-lucide", "square");
                
                statusBox.innerHTML = `
                    <div class="text-[11px] text-rose-500 flex items-center gap-1.5 font-bold animate-pulse mt-0.5">
                        <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
                        <span>Micro bận: Nói to và bắt chước nhịp điệu của câu nói mẫu...</span>
                    </div>
                `;

                // Wave bounce animation
                waveBars.forEach(bar => {
                    bar.classList.remove("opacity-30");
                    bar.classList.add("wave-bar");
                    // Custom height values in standard animation
                    bar.style.height = "";
                });
            } else {
                btn.className = "px-4 py-2.5 rounded-lg font-bold font-sans text-xs flex items-center gap-2 cursor-pointer transition-all bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm";
                btnText.textContent = "BẮT ĐẦU THU ÂM";
                if (micIcon) micIcon.setAttribute("data-lucide", "mic");

                statusBox.innerHTML = `
                    <p class="text-[10px] text-slate-400 mt-0.5">Micro sẵn sàng. Nhấp nút xanh bên dưới để ghi âm nhại tiếng.</p>
                `;

                // Pause wave bounce animation
                waveBars.forEach((bar, idx) => {
                    bar.classList.add("opacity-30");
                    bar.classList.remove("wave-bar");
                    bar.style.height = `${((idx % 4) + 1) * 3}px`;
                });
            }

            if (state.transcribedText || state.interimTranscript) {
                clearBtn.classList.remove("hidden");
            } else {
                clearBtn.classList.add("hidden");
            }

            // Sync layout icons
            lucide.createIcons();
        }

        // Update transcript placeholder box
        function updateRecordingTranscript() {
            const outputText = document.getElementById("transcription-output-text");
            const evalBtn = document.getElementById("evaluate-pronunciation-btn");

            const final = state.transcribedText;
            const interim = state.interimTranscript;

            if (final || interim) {
                outputText.className = "text-slate-800 dark:text-slate-100 font-sans";
                outputText.innerHTML = `
                    <span>${final}</span>
                    <span class="text-slate-400 italic font-normal">${interim}</span>
                `;
                
                // Enable evaluate button
                evalBtn.className = "w-full py-2.5 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 cursor-pointer shadow-md bg-indigo-600 hover:bg-indigo-700 text-white";
                evalBtn.disabled = false;
            } else {
                outputText.className = "text-slate-400 italic font-normal text-[11px]";
                outputText.textContent = "Văn bản STT thực tế tương tác sẽ khớp tại đây...";

                // Disable evaluate button
                evalBtn.className = "w-full py-2.5 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 cursor-not-allowed bg-slate-100 text-slate-400 dark:bg-slate-800/80 dark:text-slate-600";
                evalBtn.disabled = true;
            }
        }

        // Clear recording values
        function clearRecording() {
            state.transcribedText = '';
            state.interimTranscript = '';
            state.evaluation = null;
            state.selectedWord = null;

            document.getElementById("word-correction-panel").classList.add("hidden");

            updateRecordingUI();
            updateRecordingTranscript();
            renderActiveSentence();
            resetEvaluationPanel();
        }

        // Reset Evaluation Panels
        function resetEvaluationPanel() {
            document.getElementById("hud-score-value").textContent = "85";
            document.getElementById("hud-score-label").textContent = "Target Point";
            document.getElementById("hud-pace-status").textContent = "Chuẩn Bản Xứ";
            document.getElementById("hud-pitch-status").textContent = "Cân Bằng";
            updateScoreCircleRing(85);

            document.getElementById("ai-evaluation-empty").classList.remove("hidden");
            document.getElementById("ai-evaluation-list").classList.add("hidden");
            document.getElementById("ai-evaluation-list").innerHTML = "";
            document.getElementById("gemini-coach-tip-text").textContent = `"Luyện nói đều đặn hằng ngày giúp rèn vùng cơ môi tự nhiên. Ấn nút Phát âm tiếng bản xứ rồi nói nhại ngay sau để giữ nhịp thở chuẩn."`;
        }

        // Get current active sentence
        function getCurrentSentence() {
            if (!lesson.Sentences.length) {
                return { Text: '', Ipa: '', Translation: '' };
            }
            return lesson.Sentences[state.activeSentenceIndex];
        }

        function getCurrentTargetText() {
            return getCurrentSentence().Text;
        }

        // Change Active Sentence
        function changeActiveSentence(index) {
            if (index < 0 || index >= lesson.Sentences.length) return;
            state.activeSentenceIndex = index;
            loadActiveSentence({ seekVideo: true });
        }

        // Advance to next active sentence
        function advanceActiveSentence() {
            const nextIdx = (state.activeSentenceIndex + 1) % lesson.Sentences.length;
            changeActiveSentence(nextIdx);
        }

        function preservePageScroll(runUpdate) {
            const scrollX = window.scrollX;
            const scrollY = window.scrollY;
            runUpdate();
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    if (window.scrollX !== scrollX || window.scrollY !== scrollY) {
                        window.scrollTo(scrollX, scrollY);
                    }
                });
            });
        }

        // Lightweight update when video playback advances to the next sentence
        function syncSentenceFromVideo(index) {
            if (index < 0 || index >= lesson.Sentences.length) return;
            if (index === state.activeSentenceIndex) return;

            preservePageScroll(() => {
                state.activeSentenceIndex = index;
                renderActiveSentence();
                renderSubtitlesHighlight({ scroll: false });
                document.getElementById("subtitle-progress-label").textContent =
                    `${state.activeSentenceIndex + 1}/${lesson.Sentences.length}`;
            });
        }

        // Core dynamic page reload for active sentence
        function loadActiveSentence(options = {}) {
            const { skipVideoSeek = false, seekVideo = false } = options;
            state.transcribedText = '';
            state.interimTranscript = '';
            state.evaluation = null;
            state.selectedWord = null;

            // Hide warnings
            document.getElementById("word-correction-panel").classList.add("hidden");

            // Setup UI states
            updateRecordingUI();
            updateRecordingTranscript();
            renderActiveSentence();
            renderSubtitlesHighlight({ scroll: true });
            resetEvaluationPanel();

            if (seekVideo && !skipVideoSeek && youtubeVideoId && lessonHasVideoSync()) {
                seekVideoToSentence(state.activeSentenceIndex);
            }

            // Refresh game states
            resetDictationSpelling();
            fetchWordIpaForActiveSentence().then(() => generateIpaQuiz());

            // Dynamic Progress labels
            document.getElementById("subtitle-progress-label").textContent = `${state.activeSentenceIndex + 1}/${lesson.Sentences.length}`;

            // Create Icons
            lucide.createIcons();
        }

        function cleanWordToken(word) {
            return word.trim().toLowerCase().replace(/^[^a-z0-9']+|[^a-z0-9']+$/g, '');
        }

        function formatIpaDisplay(ipa) {
            if (!ipa) return '';
            const core = ipa.replace(/^\/+|\/+$/g, '').trim();
            return core ? `/${core}/` : '';
        }

        function getSentenceIpaRaw(sentence) {
            return (sentence?.Ipa ?? sentence?.ipa ?? '').trim();
        }

        function getWordIpaTokens(sentence) {
            const raw = getSentenceIpaRaw(sentence);
            if (!raw) return null;
            const core = raw.replace(/^\/+|\/+$/g, '').trim();
            if (!core) return null;
            return core.split(/\s+/).filter(Boolean);
        }

        function sentenceHasTranscriptIpa(sentence) {
            return !!getSentenceIpaRaw(sentence);
        }

        function getCachedWordIpa(cleanWord) {
            const entry = state.wordIpaCache[cleanWord];
            return entry?.ipa ? formatIpaDisplay(entry.ipa) : '';
        }

        function cacheWordLookup(cleanWord, data) {
            if (!cleanWord) return;
            state.wordIpaCache[cleanWord] = {
                ipa: data.ipa || '',
                meaning: data.meaning || ''
            };
        }

        function fetchWordIpaForActiveSentence() {
            const sentence = getCurrentSentence();
            if (!sentence || !sentence.Text) {
                return Promise.resolve();
            }

            if (sentenceHasTranscriptIpa(sentence)) {
                state.ipaLoading = false;
                return Promise.resolve();
            }

            const words = sentence.Text.split(/\s+/).filter(Boolean);
            const cleanWords = [...new Set(words.map(cleanWordToken).filter(Boolean))];
            const missing = cleanWords.filter(w => !Object.prototype.hasOwnProperty.call(state.wordIpaCache, w));

            if (missing.length === 0) {
                return Promise.resolve();
            }

            const generation = ++state.ipaFetchGeneration;
            const sentenceIndex = state.activeSentenceIndex;
            state.ipaLoading = true;
            renderActiveSentence();

            return fetch('/api/word-ipa/batch', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ words: missing })
            })
            .then(res => {
                if (!res.ok) throw new Error('Batch IPA lookup failed');
                return res.json();
            })
            .then(data => {
                if (generation !== state.ipaFetchGeneration || state.activeSentenceIndex !== sentenceIndex) {
                    return;
                }

                const results = data.results || data.Results || {};
                Object.keys(results).forEach(key => {
                    const item = results[key];
                    cacheWordLookup(key.toLowerCase(), {
                        ipa: item.ipa || item.Ipa || '',
                        meaning: item.meaning || item.Meaning || ''
                    });
                });

                missing.forEach(w => {
                    if (!Object.prototype.hasOwnProperty.call(state.wordIpaCache, w)) {
                        state.wordIpaCache[w] = { ipa: '', meaning: '' };
                    }
                });

                state.ipaLoading = false;
                renderActiveSentence();
                if (state.activeTab === 'ipa-game') {
                    generateIpaQuiz();
                }
            })
            .catch(err => {
                state.ipaLoading = false;
                console.warn('IPA batch lookup:', err);
                renderActiveSentence();
            });
        }

        // Render target text with inline IPA from dictionary API
        function renderActiveSentence() {
            const sentence = getCurrentSentence();
            if (!sentence) return;

            const words = sentence.Text.split(/\s+/).filter(Boolean);
            const ipaTokens = getWordIpaTokens(sentence);

            const container = document.getElementById("words-container");
            container.innerHTML = "";

            words.forEach((word, idx) => {
                const cleanWord = cleanWordToken(word);
                const ipaFromTranscript = ipaTokens && ipaTokens[idx]
                    ? formatIpaDisplay(ipaTokens[idx])
                    : '';
                const ipa = ipaFromTranscript || getCachedWordIpa(cleanWord);
                const wordKey = `shadow-${state.activeSentenceIndex}-${idx}`;
                const isLookupActive = state.lookupKey === wordKey;

                // Color accuracy mapping
                let accuracyClass = "text-slate-800 dark:text-slate-200 hover:text-indigo-650 dark:hover:text-sky-400";
                if (state.evaluation && state.evaluation.words) {
                    const cleanLookup = cleanWord.toLowerCase();
                    const found = state.evaluation.words.find(w => w.word.toLowerCase().replace(/[.,\/#!$%\^&\*;:{}=\-_`~()?'"]/g, "") === cleanLookup);
                    if (found) {
                        if (found.accuracyCode === 'correct') {
                            accuracyClass = "text-emerald-500 hover:bg-emerald-50 hover:dark:bg-emerald-500/10 cursor-help underline decoration-dotted transition-colors font-bold";
                        } else if (found.accuracyCode === 'warning') {
                            accuracyClass = "text-amber-500 hover:bg-amber-50 hover:dark:bg-amber-500/10 cursor-help underline decoration-dotted transition-colors font-bold";
                        } else if (found.accuracyCode === 'incorrect') {
                            accuracyClass = "text-rose-500 hover:bg-rose-50 hover:dark:bg-rose-500/10 cursor-help underline decoration-dotted transition-colors font-bold";
                        }
                    }
                }

                // Cell wrapper
                const cell = document.createElement("div");
                cell.className = "ipa-word-cell word-tooltip-container";

                // Word Text Span
                const wordSpan = document.createElement("span");
                wordSpan.className = `word-text ${accuracyClass}`;
                wordSpan.textContent = word;
                wordSpan.onclick = (e) => {
                    e.stopPropagation();
                    handleWordClick(word, wordKey);
                };

                cell.appendChild(wordSpan);

                // IPA Subtext (from dictionary cache)
                if (ipa) {
                    const ipaSpan = document.createElement("span");
                    ipaSpan.className = "word-ipa";
                    ipaSpan.textContent = ipa;
                    cell.appendChild(ipaSpan);
                } else if (cleanWord && state.ipaLoading && !ipaTokens) {
                    const ipaSpan = document.createElement("span");
                    ipaSpan.className = "word-ipa text-slate-300 dark:text-slate-600 animate-pulse";
                    ipaSpan.textContent = '…';
                    cell.appendChild(ipaSpan);
                } else if (cleanWord) {
                    const ipaSpan = document.createElement("span");
                    ipaSpan.className = "word-ipa word-ipa-empty";
                    ipaSpan.innerHTML = '&nbsp;';
                    cell.appendChild(ipaSpan);
                }

                // Definition Tooltip popup
                if (isLookupActive) {
                    const tooltip = document.createElement("div");
                    tooltip.className = "word-tooltip text-left text-xs font-sans";
                    tooltip.onclick = (e) => e.stopPropagation();

                    const tooltipHeader = document.createElement("div");
                    tooltipHeader.className = "flex justify-between items-start mb-1.5 border-b border-slate-100 dark:border-slate-850 pb-1";
                    
                    const wordTitle = document.createElement("span");
                    wordTitle.className = "font-extrabold text-slate-800 dark:text-slate-200 capitalize";
                    wordTitle.textContent = cleanWord;

                    const closeBtn = document.createElement("button");
                    closeBtn.className = "text-slate-400 hover:text-slate-600 text-[10px] font-bold cursor-pointer";
                    closeBtn.textContent = "Đóng";
                    closeBtn.onclick = (e) => {
                        e.stopPropagation();
                        state.lookupKey = null;
                        renderActiveSentence();
                    };

                    tooltipHeader.appendChild(wordTitle);
                    tooltipHeader.appendChild(closeBtn);
                    tooltip.appendChild(tooltipHeader);

                    if (state.isLookingUp) {
                        const loader = document.createElement("div");
                        loader.className = "flex items-center gap-1.5 py-1 text-slate-400";
                        loader.innerHTML = `<i data-lucide="refresh-cw" class="w-3.5 h-3.5 animate-spin"></i><span>Đang tra từ...</span>`;
                        tooltip.appendChild(loader);
                    } else if (state.wordMeaning) {
                        const meaningBody = document.createElement("div");
                        meaningBody.className = "space-y-1";
                        
                        if (state.wordMeaning.ipa) {
                            meaningBody.innerHTML += `<p class="font-mono text-indigo-500 dark:text-sky-400 font-semibold">${state.wordMeaning.ipa}</p>`;
                        }
                        meaningBody.innerHTML += `<p class="text-slate-650 dark:text-slate-350 leading-relaxed font-medium">${state.wordMeaning.meaning}</p>`;
                        tooltip.appendChild(meaningBody);
                    } else {
                        const emptyTip = document.createElement("p");
                        emptyTip.className = "text-slate-400";
                        emptyTip.textContent = "Không có dữ liệu.";
                        tooltip.appendChild(emptyTip);
                    }

                    cell.appendChild(tooltip);
                }

                container.appendChild(cell);
            });

            // Target Vietnamese translation
            document.getElementById("target-translation").textContent = `"${sentence.Translation}"`;
        }

        // Subtitle drawer rendering
        function renderSubtitlesList() {
            const container = document.getElementById("subtitles-list-container");
            document.getElementById("subtitles-count-label").textContent = lesson.Sentences.length;
            container.innerHTML = "";

            lesson.Sentences.forEach((sent, idx) => {
