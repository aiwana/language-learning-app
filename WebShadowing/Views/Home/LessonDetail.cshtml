        // Speak active target sentence — prefer lesson audio file from DB, else browser TTS
        function playTargetAudio() {
            if (lesson.AudioUrl) {
                if (!lessonAudioPlayer) {
                    lessonAudioPlayer = new Audio(lesson.AudioUrl);
                } else if (lessonAudioPlayer.src !== new URL(lesson.AudioUrl, window.location.origin).href) {
                    lessonAudioPlayer = new Audio(lesson.AudioUrl);
                }

                lessonAudioPlayer.currentTime = 0;
                lessonAudioPlayer.play().catch(err => {
                    console.error('Audio playback failed:', err);
                    playTargetAudioWithTts();
                });
                return;
            }

            playTargetAudioWithTts();
        }

        function playTargetAudioWithTts() {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const text = getCurrentSentence().Text;
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'en-US';
                utterance.rate = 0.85;
                window.speechSynthesis.speak(utterance);
            } else {
                alert('Hệ thống không hỗ trợ offline Speech Synthesis trên trình duyệt này.');
            }
        }

        // Speak custom text with WebTTS
        function playAudioText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'en-US';
                utterance.rate = 0.85;
                window.speechSynthesis.speak(utterance);
            }
        }

        // Word click lookup and speech playback
        function handleWordClick(word, key) {
            const cleanWord = word.trim().toLowerCase().replace(/[.,\/#!$%\^&\*;:{}=\-_`~()?'"]/g, "");
            if (!cleanWord) return;

            // Pronounce word immediately
            playAudioText(cleanWord);

            // Check if user clicked an evaluated word with warning/incorrect status
            if (state.evaluation && state.evaluation.words) {
                const found = state.evaluation.words.find(w => w.word.toLowerCase().replace(/[.,\/#!$%\^&\*;:{}=\-_`~()?'"]/g, "") === cleanWord);
                if (found && (found.accuracyCode === 'warning' || found.accuracyCode === 'incorrect')) {
                    state.selectedWord = found;
                    showWordCorrectionNotice(found);
                } else {
                    document.getElementById("word-correction-panel").classList.add("hidden");
                }
            }

            // Query meaning from API (reuse cache when available)
            state.lookupKey = key;
            state.isLookingUp = true;

            const cached = state.wordIpaCache[cleanWord];
            if (cached?.meaning || cached?.ipa) {
                state.wordMeaning = {
                    word: cleanWord,
                    meaning: cached.meaning || 'Không tìm thấy nghĩa.',
                    ipa: formatIpaDisplay(cached.ipa)
                };
                state.isLookingUp = false;
                renderActiveSentence();
                return;
            }

            state.wordMeaning = null;
            renderActiveSentence();

            fetch('/api/word-meaning', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ word: cleanWord, context: getCurrentSentence().Text })
            })
            .then(res => res.json())
            .then(data => {
                cacheWordLookup(cleanWord, data);
                state.wordMeaning = {
                    word: cleanWord,
                    meaning: data.meaning || 'Không tìm thấy nghĩa.',
                    ipa: formatIpaDisplay(data.ipa)
                };
            })
            .catch(() => {
                state.wordMeaning = {
                    word: cleanWord,
                    meaning: 'Lỗi tra cứu từ điển.',
                    ipa: ''
                };
            })
            .finally(() => {
                state.isLookingUp = false;
                renderActiveSentence();
            });
        }

        // Show correction notice box
        function showWordCorrectionNotice(found) {
            const panel = document.getElementById("word-correction-panel");
            const wName = document.getElementById("correcting-word-name");
            const wBadge = document.getElementById("correcting-word-badge");
            const wIpa = document.getElementById("correcting-word-ipa");
            const wTip = document.getElementById("correcting-word-tip");

            panel.classList.remove("hidden");
            wName.textContent = `"${found.word}"`;
            wBadge.textContent = found.accuracyCode === 'incorrect' ? '(Phát âm chưa chính xác)' : '(Cần cải thiện)';
            wIpa.textContent = found.ipa ? `IPA chuẩn: ${found.ipa}` : '';
            wTip.textContent = found.correction || 'Chú ý nhấn đúng âm tiết trọng âm và phát âm rõ phụ âm gió đuôi.';
        }

