        // Update radial score wheel circle offset
        function updateScoreCircleRing(score) {
            const circle = document.getElementById("score-circle-ring");
            const circumference = 326.7;
            const offset = circumference - (score / 100) * circumference;
            circle.style.strokeDashoffset = offset;

            // Change color class based on score
            if (score >= 80) {
                circle.setAttribute("stroke", "#10b981");
            } else if (score >= 60) {
                circle.setAttribute("stroke", "#f59e0b");
            } else {
                circle.setAttribute("stroke", "#ef4444");
            }
        }

        // Call evaluate pronunciation API
        function evaluatePronunciation() {
            const transcript = state.transcribedText.trim();
            if (!transcript) {
                alert('Vui lòng thu âm hoặc chọn "Ghi âm giả lập" trước khi tiến hành chấm điểm.');
                return;
            }

            state.isEvaluating = true;
            state.selectedWord = null;
            document.getElementById("word-correction-panel").classList.add("hidden");

            // Toggle loading panels
            document.getElementById("ai-evaluation-loading").classList.remove("hidden");
            document.getElementById("ai-evaluation-empty").classList.add("hidden");
            document.getElementById("ai-evaluation-list").classList.add("hidden");

            fetch('/api/evaluate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    targetText: getCurrentSentence().Text,
                    transcript: transcript,
                    level: lesson.Topic,
                    userGoal: 'comprehension70'
                })
            })
            .then(res => res.json())
            .then(data => {
                state.evaluation = data;
                
                // Update stats locally
                state.expGained += data.score >= 80 ? 15 : (data.score >= 60 ? 10 : 5);
                updateStatsInHeader();

                if (currentSessionId) {
                    fetch('/api/practice/complete', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            sessionId: currentSessionId,
                            overallScore: data.score
                        })
                    })
                    .then(res => {
                        if (!res.ok) throw new Error("Complete session failed");
                        return res.json();
                    })
                    .then(completeData => {
                        console.log("Practice session completed:", completeData.message);
                        currentSessionId = null;
                    })
                    .catch(err => console.error("Error completing practice:", err));
                }

                // Display score details
                document.getElementById("hud-score-value").textContent = data.score;
                document.getElementById("hud-score-label").textContent = "Pronunciation Score";
                document.getElementById("hud-pace-status").textContent = data.score >= 80 ? 'Perfect / Good' : 'Moderate';
                document.getElementById("hud-pitch-status").textContent = 'Tự nhiên';
                updateScoreCircleRing(data.score);

                // Render word breakdown detail
                const listContainer = document.getElementById("ai-evaluation-list");
                listContainer.innerHTML = "";

                data.words.forEach(w => {
                    let barBg = 'bg-emerald-500';
                    let descriptionText = 'Phát âm chuẩn xác cấu trúc âm vị học.';
                    if (w.accuracyCode === 'warning') {
                        barBg = 'bg-amber-500';
                        descriptionText = w.correction || 'Trọng âm chưa chính xác, hãy tăng độ ngân.';
                    } else if (w.accuracyCode === 'incorrect') {
                        barBg = 'bg-rose-500';
                        descriptionText = w.correction || 'Âm vị sai hoặc thiếu hoàn toàn, cần luyện lại.';
                    }

                    const row = document.createElement("div");
                    row.className = "flex items-start gap-2.5 text-xs text-left";
                    row.innerHTML = `
                        <span class="w-[3px] h-9 shrink-0 rounded-full mt-0.5 ${barBg}"></span>
                        <div>
                            <p class="font-bold text-slate-800 dark:text-slate-100 capitalize">${w.word}</p>
                            <p class="text-[10px] text-slate-400 font-mono mt-0.5">${descriptionText}</p>
                        </div>
                    `;
                    listContainer.appendChild(row);
                });

                document.getElementById("gemini-coach-tip-text").textContent = data.feedback;

                // Toggle visibility
                document.getElementById("ai-evaluation-list").classList.remove("hidden");
                
                // Re-render sentence to update colors of text words
                renderActiveSentence();
            })
            .catch(err => {
                console.error("Evaluation error: ", err);
                alert("Gặp sự cố kết nối tới máy chủ AI.");
                document.getElementById("ai-evaluation-empty").classList.remove("hidden");
            })
            .finally(() => {
                state.isEvaluating = false;
                document.getElementById("ai-evaluation-loading").classList.add("hidden");
            });
        }

