        // ==================== IPA GAME MODULE ====================
        function generateIpaQuiz() {
            const sentence = getCurrentSentence();
            if (!sentence) return;

            const cleanWords = sentence.Text
                .replace(/[.,\/#!$%\^&\*;:{}=\-_`~()?]/g, "")
                .split(/\s+/)
                .filter(Boolean);

            if (cleanWords.length === 0) return;

            const correctWord = cleanWords[Math.floor(cleanWords.length / 2)].toLowerCase();
            const ipaTokens = getWordIpaTokens(sentence);
            const correctIndex = Math.floor(cleanWords.length / 2);
            const pool = ['about', 'around', 'activity', 'routine', 'people', 'coffee', 'business', 'environment', 'important', 'strategy', 'science', 'technology'];
            const distractors = pool
                .filter(w => w !== correctWord)
                .sort(() => 0.5 - Math.random())
                .slice(0, 3);

            const options = [correctWord, ...distractors].sort(() => 0.5 - Math.random());

            state.ipaQuizCorrect = correctWord;
            state.ipaQuizOptions = options;
            state.ipaSelectedAnswer = null;
            state.ipaFeedbackMessage = null;

            // IPA segment from transcript or dictionary cache
            let ipaSegment = "";
            if (ipaTokens && ipaTokens[correctIndex]) {
                ipaSegment = formatIpaDisplay(ipaTokens[correctIndex]);
            } else {
                const cachedIpa = getCachedWordIpa(correctWord);
                ipaSegment = cachedIpa || `[${correctWord}]`;
            }

            document.getElementById("ipa-quiz-text").textContent = ipaSegment;
            document.getElementById("ipa-feedback-box").classList.add("hidden");
            document.getElementById("ipa-next-btn").classList.add("hidden");

            renderIpaQuizOptions();
        }

        function renderIpaQuizOptions() {
            const container = document.getElementById("ipa-options-grid");
            container.innerHTML = "";

            state.ipaQuizOptions.forEach(opt => {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "p-2.5 rounded-lg border text-xs font-bold capitalize transition-all cursor-pointer border-slate-200 hover:border-indigo-600 dark:border-slate-800 dark:hover:border-sky-500 bg-white dark:bg-slate-950 text-slate-800 dark:text-slate-200";
                btn.textContent = opt;
                btn.onclick = () => selectIpaAnswer(opt, btn);

                container.appendChild(btn);
            });
        }

        function selectIpaAnswer(option, clickedBtn) {
            if (state.ipaSelectedAnswer) return; // Answer locked

            state.ipaSelectedAnswer = option;
            const isCorrect = (option === state.ipaQuizCorrect);
            const feedbackBox = document.getElementById("ipa-feedback-box");
            feedbackBox.classList.remove("hidden");

            // Disable all option buttons and color the correct/incorrect answers
            const buttons = document.getElementById("ipa-options-grid").querySelectorAll("button");
            buttons.forEach(btn => {
                btn.disabled = true;
                const text = btn.textContent.toLowerCase();
                if (text === state.ipaQuizCorrect) {
                    btn.className = "p-2.5 rounded-lg border text-xs font-bold capitalize transition-all bg-emerald-50/15 border-emerald-500 text-emerald-600";
                } else if (text === option) {
                    btn.className = "p-2.5 rounded-lg border text-xs font-bold capitalize transition-all bg-rose-50/15 border-rose-500 text-rose-500";
                } else {
                    btn.className = "p-2.5 rounded-lg border text-xs font-bold capitalize transition-all opacity-40 border-slate-100 dark:border-slate-850 bg-transparent text-slate-400";
                }
            });

            if (isCorrect) {
                state.expGained += 15;
                state.ipaFeedbackMessage = "Chúc mừng! Đáp án hoàn toàn chuẩn xác. IPA này khớp với từ: " + option;
                feedbackBox.className = "p-3 rounded-lg text-xs leading-normal flex gap-2 border bg-emerald-50/50 text-emerald-800 border-emerald-200 dark:bg-emerald-500/5 dark:text-emerald-400 dark:border-emerald-500/10";
            } else {
                state.ipaFeedbackMessage = `Rất tiếc! Chưa chính xác rồi. Phiên âm này thuộc về từ "${state.ipaQuizCorrect}".`;
                feedbackBox.className = "p-3 rounded-lg text-xs leading-normal flex gap-2 border bg-rose-50/50 text-rose-800 border-rose-200 dark:bg-rose-500/5 dark:text-rose-400 dark:border-rose-500/10";
                if (!state.isPremium) {
                    state.heartsRemaining = Math.max(0, state.heartsRemaining - 1);
                }
            }

            feedbackBox.innerHTML = `
                <i data-lucide="help-circle" class="w-4 h-4 shrink-0"></i>
                <p class="font-sans font-medium text-[11px]">${state.ipaFeedbackMessage}</p>
            `;

            updateStatsInHeader();
            document.getElementById("ipa-next-btn").classList.remove("hidden");
            lucide.createIcons();
        }

        function advanceIpaQuizSentence() {
            advanceActiveSentence();
        }

        // ==================== ROLE PLAY MODE FUNCTIONS ====================
        function loadRolePlay() {
            state.isLoadingRolePlay = true;
            state.selectedRole = null;
            state.rolePlayActiveIndex = 0;
            state.rolePlayMessages = [];
            state.rolePlaySTTText = '';
            state.rolePlayInterimSTT = '';

            document.getElementById("roleplay-loader").classList.remove("hidden");
            document.getElementById("roleplay-content").classList.add("hidden");

            // Call backend API
            fetch('/api/generate-roleplay', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    topic: lesson.Title,
                    level: lesson.Level,
                    existingSentences: lesson.IsDialogue ? lesson.Sentences : null
                })
            })
            .then(res => res.json())
            .then(data => {
                state.rolePlayMessages = data.messages || [];
                state.rolePlaySpeakers = data.speakers || [];
                if (data.speakers && data.speakers.length > 0) {
                    // Set default user role to second speaker
                    state.selectedRole = data.speakers[1] || data.speakers[0];
                }

                // Initial conversation mapping
                setupRoleSelection();
                renderRolePlayChat();
                renderRolePlayControls();
                renderRolePlayScriptReference();

                document.getElementById("roleplay-content").classList.remove("hidden");
            })
            .catch(err => {
                console.error("Roleplay load failed:", err);
                alert("Lỗi tải đàm thoại Roleplay.");
            })
            .finally(() => {
                state.isLoadingRolePlay = false;
                document.getElementById("roleplay-loader").classList.add("hidden");
            });
        }

        function setupRoleSelection() {
            const container = document.getElementById("role-selection-container");
            container.innerHTML = "";

            state.rolePlaySpeakers.forEach(spk => {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = `px-3 py-1.5 rounded-xl border text-xs font-bold transition-all cursor-pointer ${
                    state.selectedRole === spk
                        ? 'bg-indigo-600 border-indigo-600 text-white shadow-sm'
                        : 'bg-white border-slate-200 text-slate-650 hover:bg-slate-100 dark:bg-slate-900 dark:border-slate-800 dark:text-slate-300'
                }`;
                btn.innerHTML = `<i data-lucide="user" class="w-3.5 h-3.5 inline mr-1"></i><span>Đóng vai ${spk}</span>`;
                btn.onclick = () => {
                    handleSelectRole(spk);
                };
                container.appendChild(btn);
            });
            lucide.createIcons();
        }

        function handleSelectRole(role) {
            state.selectedRole = role;
            state.rolePlayActiveIndex = 0;
            state.rolePlaySTTText = '';
            state.rolePlayInterimSTT = '';

            state.rolePlayMessages = state.rolePlayMessages.map(msg => ({
                ...msg,
                isUser: msg.speaker === role,
                isPlayed: false,
                score: undefined,
                spokenText: undefined
            }));

            setupRoleSelection();
            renderRolePlayChat();
            renderRolePlayControls();
            
            // If first message is AI, trigger auto-play
            checkRolePlayTurn();
        }

        function renderRolePlayChat() {
            const container = document.getElementById("chat-bubbles-container");
            container.innerHTML = "";

            const visibleMessages = state.rolePlayMessages.slice(0, state.rolePlayActiveIndex + 1);
            visibleMessages.forEach((msg, idx) => {
                const isActive = (idx === state.rolePlayActiveIndex);
                const isUser = (msg.speaker === state.selectedRole);
                const hasScore = (msg.score !== undefined);

                // If active message and user's turn (waiting to speak)
                if (isActive && isUser && !msg.isPlayed) {
                    const bubble = document.createElement("div");
                    bubble.className = "chat-bubble align-self-end bg-slate-100 border border-dashed border-indigo-300 dark:bg-slate-900 dark:border-indigo-950 text-slate-600 dark:text-slate-400 max-w-[85%]";
                    bubble.innerHTML = `
                        <span class="speaker-tag text-indigo-500 font-bold">${msg.speaker} (Lượt của bạn)</span>
                        <p class="font-sans font-black text-xs text-slate-900 dark:text-slate-200">${msg.text}</p>
                        <p class="font-mono text-[9px] opacity-75 mt-1">${msg.ipa}</p>
                        <p class="text-[10px] opacity-80 mt-1 italic">"${msg.translation}"</p>
                        <div class="mt-2 text-[9px] text-indigo-600 dark:text-sky-400 font-semibold flex items-center gap-1 animate-pulse">
                            <i data-lucide="mic" class="w-3 h-3"></i>
                            <span>Hãy nhấn Micro ở bên dưới để đọc câu thoại này...</span>
                        </div>
                    `;
                    container.appendChild(bubble);
                    return;
                }

                // Regular chat bubbles
                const bubble = document.createElement("div");
                bubble.className = `chat-bubble max-w-[80%] ${
                    isUser ? 'chat-bubble-user align-self-end font-semibold' : 'chat-bubble-ai align-self-start'
                } ${isActive ? 'ring-2 ring-indigo-500/80 ring-offset-2 dark:ring-offset-slate-900 scale-[1.01]' : 'opacity-90'}`;

                // Word span mapping with dictionary tooltips
                let textHtml = "";
                msg.text.split(/\s+/).forEach((word, wIdx) => {
                    const wordKey = `rp-${msg.id}-${wIdx}`;
                    textHtml += `<span class="relative inline-block mr-1">
                        <span class="cursor-pointer hover:underline decoration-indigo-300 decoration-dotted select-none" onclick="event.stopPropagation(); handleRolePlayWordClick('${word.replace(/'/g, "\\'")}', '${wordKey}', '${msg.text.replace(/'/g, "\\'")}')">${word}</span>
                    </span>`;
                });

                bubble.innerHTML = `
                    <span class="speaker-tag">${msg.speaker}</span>
                    <div class="font-sans font-bold text-xs select-none">${textHtml}</div>
                    <p class="font-mono text-[9px] opacity-75 mt-1">${msg.ipa}</p>
                    <p class="text-[10px] opacity-80 mt-1 italic">"${msg.translation}"</p>
                    ${msg.spokenText && msg.spokenText !== msg.text ? `
                        <p class="text-[9px] opacity-70 mt-1.5 border-t border-white/10 dark:border-slate-850 pt-1.5">
                            Bạn nói: <span class="font-mono italic">"${msg.spokenText}"</span>
                        </p>
                    ` : ''}
                    <div class="mt-2 pt-1.5 border-t border-white/15 dark:border-slate-800 flex justify-between items-center gap-2">
                        <button onclick="playAudioText('${msg.text.replace(/'/g, "\\'")}')" class="p-1 rounded bg-black/10 hover:bg-black/20 dark:bg-white/5 dark:hover:bg-white/10 text-current cursor-pointer transition-colors" title="Phát âm">
                            <i data-lucide="volume-2" class="w-3 h-3"></i>
                        </button>
                        ${hasScore ? `<span class="text-[8px] font-mono bg-white/20 px-1.5 py-0.5 rounded font-bold">Đúng: ${msg.score}%</span>` : ''}
                    </div>
                `;

                container.appendChild(bubble);
            });

            // Smooth scroll to bottom
            container.scrollTop = container.scrollHeight;
            lucide.createIcons();
        }

        // Click-to-Translate inside Roleplay bubble
        function handleRolePlayWordClick(word, key, context) {
            const cleanWord = word.trim().toLowerCase().replace(/[.,\/#!$%\^&\*;:{}=\-_`~()?'"]/g, "");
            if (!cleanWord) return;

            playAudioText(cleanWord);
            
            // Simply alert details or pop up (roleplay tooltips simplified to overlay/alert for cleaner structure)
            state.isLookingUp = true;
            fetch('/api/word-meaning', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ word: cleanWord, context: context })
            })
            .then(res => res.json())
            .then(data => {
                alert(`Tra từ: "${cleanWord}"\nPhát âm: ${data.ipa || '/' + cleanWord + '/'}\nÝ nghĩa: ${data.meaning}`);
            })
            .catch(() => {
                alert(`Lỗi tra từ "${cleanWord}".`);
            });
        }

        function renderRolePlayControls() {
            const container = document.getElementById("roleplay-controls-container");
            container.innerHTML = "";

            if (state.rolePlayActiveIndex >= state.rolePlayMessages.length) {
                // Scenario completed
                const card = document.createElement("div");
                card.className = "text-center p-4 bg-slate-50 dark:bg-slate-950/40 border border-slate-100 dark:border-slate-800/80 rounded-2xl font-sans space-y-2.5";
                card.innerHTML = `
                    <i data-lucide="trophy" class="w-7 h-7 text-amber-500 mx-auto"></i>
                    <h4 class="font-extrabold text-sm text-slate-800 dark:text-slate-100">Kịch bản hoàn tất!</h4>
                    <button onclick="resetRolePlay()" class="px-4 py-2 bg-indigo-600 text-white rounded-xl text-xs font-bold hover:bg-indigo-700 cursor-pointer shadow-sm">
                        Luyện lại
                    </button>
                `;
                container.appendChild(card);
                lucide.createIcons();
                return;
            }

            const activeMsg = state.rolePlayMessages[state.rolePlayActiveIndex];
            const isUserTurn = (activeMsg?.speaker === state.selectedRole);

            if (!isUserTurn) {
                // AI Speaker turn
                const bar = document.createElement("div");
                bar.className = "p-4 bg-slate-50 dark:bg-slate-950/40 border border-slate-150 dark:border-slate-850 rounded-2xl flex justify-between items-center gap-3 font-sans text-xs w-full";
                bar.innerHTML = `
                    <div class="text-left flex-1">
                        <span class="text-[9px] uppercase font-bold text-slate-400 block tracking-wider">Lượt nói của AI (${activeMsg?.speaker})</span>
                        <p class="font-bold text-indigo-650 dark:text-sky-400 mt-0.5 animate-pulse">"${activeMsg?.text}"</p>
                    </div>
                    <button onclick="playAudioText('${activeMsg?.text.replace(/'/g, "\\'")}')" class="px-3.5 py-2 bg-indigo-650 hover:bg-indigo-700 text-white rounded-xl font-bold flex items-center gap-1 cursor-pointer shrink-0">
                        <i data-lucide="volume-2" class="w-3.5 h-3.5"></i>
                        <span>Nghe AI nói</span>
                    </button>
                `;
                container.appendChild(bar);
            } else {
                // User Speaker turn
                const panel = document.createElement("div");
                panel.className = "flex flex-col items-center justify-center p-4 bg-slate-50 dark:bg-slate-950/40 border border-slate-150 dark:border-slate-850 rounded-2xl gap-3 w-full";
                
                if (state.isEvaluatingRolePlay) {
                    panel.innerHTML = `
                        <div class="flex flex-col items-center gap-2 py-2">
                            <i data-lucide="refresh-cw" class="w-6 h-6 text-indigo-600 animate-spin"></i>
                            <span class="text-xs font-bold text-slate-500 dark:text-slate-400">AI đang phân tích & chấm điểm phát âm...</span>
                        </div>
                    `;
                } else {
                    panel.innerHTML = `
                        <div class="flex flex-col items-center gap-2.5 w-full">
                            <!-- Live transcript display -->
                            ${state.isRecording ? `
                                <div class="w-full text-center px-4 py-2 bg-rose-50 dark:bg-rose-950/20 border border-rose-100 dark:border-rose-900/50 rounded-xl">
                                    <p class="text-xs font-bold text-rose-600 dark:text-rose-400 flex items-center justify-center gap-1.5 animate-pulse">
                                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
                                        <span>Đang ghi âm giọng nói của bạn...</span>
                                    </p>
                                    <p class="text-xs font-bold text-slate-800 dark:text-slate-150 mt-1 font-sans">
                                        "${state.rolePlaySTTText || ''} <span class="text-slate-400 font-normal italic">${state.rolePlayInterimSTT || ''}</span>"
                                    </p>
                                </div>
                            ` : ''}

                            <div class="flex items-center justify-center gap-3">
                                <button id="rp-mic-toggle" onclick="handleToggleRecording()" class="w-14 h-14 rounded-full flex items-center justify-center transition-all shadow-md cursor-pointer hover:scale-105 ${
                                    state.isRecording ? 'bg-rose-600 hover:bg-rose-700 text-white animate-pulse' : 'bg-emerald-600 hover:bg-emerald-700 text-white'
                                }">
                                    <i data-lucide="${state.isRecording ? 'square' : 'mic'}" class="w-6 h-6 text-white"></i>
                                </button>
                                
                                <button onclick="simulateRoleplaySpeak()" class="px-2.5 py-1.5 border border-dashed border-indigo-200 text-indigo-500 rounded-lg text-[10px] font-bold dark:border-slate-800 dark:text-sky-400" title="Giả lập giọng nói khi không có micro">
                                    Giả lập thoại
                                </button>
                            </div>

                            <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                                ${state.isRecording ? "Nhấn dừng để gửi bài nói ngay" : "Nhấn Micro để bắt đầu thu âm thoại"}
                            </span>
                        </div>
                    `;
                }

                container.appendChild(panel);
            }
            lucide.createIcons();
        }

        function renderRolePlayScriptReference() {
            const container = document.getElementById("roleplay-script-reference");
            container.innerHTML = "";

            state.rolePlayMessages.forEach(msg => {
                const row = document.createElement("div");
                row.className = "flex gap-2.5 items-start border-b border-slate-100 dark:border-slate-900 pb-2";
                row.innerHTML = `
                    <span class="font-mono font-bold text-[10px] text-indigo-500 dark:text-sky-400 uppercase w-20 shrink-0 mt-0.5">
                        ${msg.speaker}:
                    </span>
                    <div class="flex-1">
                        <p class="font-bold text-slate-800 dark:text-slate-200">${msg.text}</p>
                        <p class="text-[10px] text-slate-400 font-mono mt-0.5">${msg.ipa}</p>
                        <p class="text-[10px] text-slate-400 italic mt-0.5">"${msg.translation}"</p>
                    </div>
                    <button onclick="playAudioText('${msg.text.replace(/'/g, "\\'")}')" class="p-1 rounded hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-400 hover:text-slate-650 cursor-pointer">
                        <i data-lucide="volume-2" class="w-3.5 h-3.5"></i>
                    </button>
                `;
                container.appendChild(row);
            });
            lucide.createIcons();
        }

        // Checks if current turn is AI and triggers auto play delay
        function checkRolePlayTurn() {
            if (state.activeTab !== 'roleplay' || state.rolePlayMessages.length === 0) return;
            if (state.rolePlayActiveIndex >= state.rolePlayMessages.length) return;

            const activeMsg = state.rolePlayMessages[state.rolePlayActiveIndex];
            if (activeMsg && activeMsg.speaker !== state.selectedRole) {
                // It is the AI's turn!
                // 1. Play voice
                playAudioText(activeMsg.text);

                // 2. Set dynamic delay based on character length
                const delay = Math.max(1800, activeMsg.text.length * 80);

                // 3. Move index forward
                setTimeout(() => {
                    if (state.activeTab === 'roleplay' && state.rolePlayActiveIndex < state.rolePlayMessages.length) {
                        state.rolePlayActiveIndex++;
                        renderRolePlayChat();
                        renderRolePlayControls();
                        checkRolePlayTurn(); // recursive check
                    }
                }, delay);
            }
        }

        // Send user transcript inside Roleplay and evaluate
        function sendSpeechMessage(transcript) {
            if (!transcript.trim()) return;

            const activeMsg = state.rolePlayMessages[state.rolePlayActiveIndex];
            if (!activeMsg) return;

            state.isEvaluatingRolePlay = true;
            renderRolePlayControls();

            fetch('/api/evaluate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    targetText: activeMsg.text,
                    transcript: transcript,
                    level: lesson.Topic,
                    userGoal: 'comprehension70'
                })
            })
            .then(res => res.json())
            .then(data => {
                // Update stats
                state.expGained += data.score >= 80 ? 15 : (data.score >= 60 ? 10 : 5);
                updateStatsInHeader();

                // Save score
                state.rolePlayMessages[state.rolePlayActiveIndex].score = data.score;
                state.rolePlayMessages[state.rolePlayActiveIndex].spokenText = transcript;
                state.rolePlayMessages[state.rolePlayActiveIndex].isPlayed = true;

                // Move forward
                state.rolePlayActiveIndex++;
                renderRolePlayChat();
                renderRolePlayControls();

                // Check next turns
                checkRolePlayTurn();
            })
            .catch(err => {
                console.error(err);
                // Fallback score
                state.rolePlayMessages[state.rolePlayActiveIndex].score = 80;
                state.rolePlayMessages[state.rolePlayActiveIndex].spokenText = transcript;
                state.rolePlayMessages[state.rolePlayActiveIndex].isPlayed = true;

                state.rolePlayActiveIndex++;
                renderRolePlayChat();
                renderRolePlayControls();
                checkRolePlayTurn();
            })
            .finally(() => {
                state.isEvaluatingRolePlay = false;
                state.rolePlaySTTText = '';
                state.rolePlayInterimSTT = '';
                renderRolePlayControls();
            });
        }

        // Simulate voice typing inside Roleplay
        function simulateRoleplaySpeak() {
            if (state.isRecording) {
                handleToggleRecording();
                return;
            }

            state.isRecording = true;
            state.rolePlaySTTText = 'Đang nhận diện giọng nói...';
            state.rolePlayInterimSTT = '';
            renderRolePlayControls();

            const targetText = state.rolePlayMessages[state.rolePlayActiveIndex].text;

            recordingSimTimer = setTimeout(() => {
                state.isRecording = false;
                state.rolePlaySTTText = targetText;
                state.rolePlayInterimSTT = '';
                sendSpeechMessage(targetText);
            }, 3000);
        }

        // Restart Role Play session
        function resetRolePlay() {
            state.rolePlayActiveIndex = 0;
            state.rolePlayMessages = state.rolePlayMessages.map(m => ({
                ...m,
                isPlayed: false,
                score: undefined,
                spokenText: undefined
            }));

            renderRolePlayChat();
            renderRolePlayControls();
            checkRolePlayTurn();
        }
    </script>
}
