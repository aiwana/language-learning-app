@* Chức năng: trang chi tiết dùng chung cho bài curated, Video Bank, AI draft và AI saved.
   Phân công tab: Minh Anh — Shadowing/Đối thoại AI/giao diện; Minh — Dictation/IPA và logic chấm.
   Thay đổi DOM id hoặc initial JSON phải đồng bộ lesson-shadowing.js và lesson-practice-tabs.js. *@
@{
    ViewData["Title"] = "Shadowing Studio";
    var lessonId = (long)(ViewBag.LessonId ?? 0L);
    var learningMode = (string)(ViewBag.LearningMode ?? "casual");
    var lessonTitle = (string)(ViewBag.LessonTitle ?? "Bài học");
    var initialLessonJson = (string)(ViewBag.InitialLessonJson ?? "null");
    var pronunciationAiConfigured = (bool)(ViewBag.PronunciationAiConfigured ?? false);
    var isVip = (bool)(ViewBag.IsVip ?? false);
    var hasVideo = (bool)(ViewBag.HasVideo ?? false);
    var supportsDictation = (bool)(ViewBag.SupportsDictation ?? hasVideo);
    var isAiLesson = (bool)(ViewBag.IsAiLesson ?? false);
    var isSavedAiLesson = (bool)(ViewBag.IsSavedAiLesson ?? false);
    var aiPreviewId = (Guid?)(ViewBag.AiPreviewId);
    var savedAiLessonId = (long?)(ViewBag.SavedAiLessonId);
}

<link rel="stylesheet" href="~/css/lesson-detail.css" asp-append-version="true" />

<script>
    window.__lessonId = @lessonId;
    window.__learningMode = "@learningMode";
    window.__initialLesson = @Html.Raw(initialLessonJson);
    window.__pronunciationAiConfigured = @pronunciationAiConfigured.ToString().ToLowerInvariant();
    window.__isVip = @isVip.ToString().ToLowerInvariant();
    window.__aiLesson = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { isAiLesson, isSaved = isSavedAiLesson, previewId = aiPreviewId, savedLessonId = savedAiLessonId }, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
</script>

<div id="dict-bubble"
     class="dict-bubble d-none"
     role="dialog"
     aria-modal="false"
     aria-labelledby="dict-word"
     aria-live="polite">
    <button type="button" class="dict-bubble-close" aria-label="Đóng từ điển">x</button>
    <p class="dict-bubble-word" id="dict-word"></p>
    <p class="dict-bubble-ipa font-mono" id="dict-ipa"></p>
    <p class="dict-bubble-meaning" id="dict-meaning"></p>
</div>

<main class="lesson-detail-page lesson-detail-simple">
    <section id="page-error" class="d-none lesson-empty-state">
        <div class="lesson-state-icon lesson-state-icon-red">
            <i data-lucide="alert-circle"></i>
        </div>
        <h1>Không tải được bài học</h1>
        <p id="page-error-msg">Vui lòng thử lại sau ít phút.</p>
        <a class="btn btn-outline-primary btn-sm rounded-pill fw-bold" asp-controller="Home" asp-action="Index" asp-route-mode="@learningMode">
            Về danh sách khóa học
        </a>
    </section>

    <section id="lesson-studio" class="lesson-studio-shell">
        <header class="lesson-simple-hero">
            <div class="lesson-simple-copy">
                <a class="lesson-back-link" asp-controller="Home" asp-action="Index" asp-route-mode="@learningMode">
                    <i data-lucide="arrow-left"></i>
                    <span>Khóa học</span>
                </a>
                <span class="lesson-kicker">Shadowing Studio</span>
                <h1 id="lesson-title">@lessonTitle</h1>
                <p>Luyện theo từng đoạn ngắn, thu âm lại và chỉ qua câu tiếp theo khi đạt mục tiêu phát âm.</p>
            </div>

            <div class="lesson-simple-stats" aria-label="Thông tin luyện tập">
                <div class="lesson-simple-stat lesson-simple-stat-blue">
                    <strong id="subtitles-count">0</strong>
                    <span>câu luyện</span>
                </div>
                <div class="lesson-simple-stat lesson-simple-stat-violet">
                    <strong id="pronunciation-target-label">70%</strong>
                    <span>mục tiêu</span>
                </div>
            </div>
        </header>

        <div class="lesson-mode-tabs">
        <nav class="lesson-mode-tablist" aria-label="Chế độ luyện tập" role="tablist">
            <button type="button"
                    id="shadowing-tab"
                    class="lesson-mode-tab is-active"
                    role="tab"
                    aria-selected="true"
                    aria-controls="shadowing-tab-panel"
                    data-tab="shadowing"
                    onclick="switchTab('shadowing')">
                <i data-lucide="mic-2"></i>
                <span>Shadowing Studio</span>
            </button>
            <button type="button"
                    id="ai-dialogue-tab"
                    class="lesson-mode-tab @(!isVip || isAiLesson ? "is-locked" : "")"
                    role="tab"
                    aria-selected="false"
                    aria-controls="ai-dialogue-tab-panel"
                    title="Đối thoại AI dành cho VIP"
                    data-tab="ai-dialogue"
                    aria-disabled="@(isAiLesson ? "true" : "false")"
                    disabled="@(isAiLesson ? "disabled" : null)"
                    onclick="switchTab('ai-dialogue')">
                <i data-lucide="@(isVip ? "messages-square" : "lock-keyhole")"></i>
                <span>Đối thoại AI</span>
                <small>VIP</small>
            </button>
            <button type="button"
                    id="dictation-tab"
                    class="lesson-mode-tab @(!supportsDictation ? "is-coming-soon" : "")"
                    role="tab"
                    aria-selected="false"
                    aria-controls="dictation-tab-panel"
                    aria-disabled="@(!supportsDictation ? "true" : "false")"
                    disabled="@(!supportsDictation ? "disabled" : null)"
                    title="@(!hasVideo ? "Nghe chép cho bài học audio đang được phát triển" : "Luyện nghe chép chính tả")"
                    data-tab="dictation"
                    onclick="@(supportsDictation ? "switchTab('dictation')" : null)">
                <i data-lucide="@(supportsDictation ? "headphones" : "clock-3")"></i>
                <span>Nghe chép</span>
                @if (!supportsDictation)
                {
                    <small>Sắp ra mắt</small>
                }
            </button>
            <button type="button"
                    id="ipa-match-tab"
                    class="lesson-mode-tab"
                    role="tab"
                    aria-selected="false"
                    aria-controls="ipa-match-tab-panel"
                    data-tab="ipa-match"
                    onclick="switchTab('ipa-match')">
                <i data-lucide="spell-check-2"></i>
                <span>Ghép IPA</span>
            </button>
        </nav>
        @if (isAiLesson)
        {
            <div class="ai-lesson-toolbar-actions" aria-label="Thao tác bài học AI">
                @if (!isSavedAiLesson)
                {
                    <button type="button"
                            id="save-ai-detail"
                            class="ai-lesson-action ai-lesson-action-save"
                            title="Lưu vào thư viện"
                            aria-label="Lưu bài học vào thư viện">
                        <i data-lucide="bookmark-plus" aria-hidden="true"></i>
                        <span>Lưu bài</span>
                    </button>
                }
                <button type="button"
                        id="delete-ai-detail"
                        class="ai-lesson-action ai-lesson-action-delete"
                        title="Xóa bài học"
                        aria-label="Xóa bài học AI">
                    <i data-lucide="trash-2" aria-hidden="true"></i>
                    <span>Xóa bài</span>
                </button>
                <span id="ai-detail-status" class="visually-hidden" role="status" aria-live="polite"></span>
            </div>
        }
        </div>

        <section id="shadowing-tab-panel"
                 class="lesson-top-grid"
                 role="tabpanel"
                 aria-labelledby="shadowing-tab">
            <div class="lesson-left-stack">
                <div class="lesson-media-stage">
                    <div id="youtube-player-wrap" class="d-none lesson-media-card lesson-primary-media">
                        <div class="ratio ratio-16x9">
                            <div id="youtube-player"></div>
                        </div>
                    </div>

                </div>

                <section class="lesson-practice-section" aria-label="Câu đang luyện và thu âm">
                    <article class="lesson-panel lesson-practice-card lesson-recording-workbench">
                        <span id="sentence-time-info" class="d-none"></span>

                        <div id="audio-player-wrap" class="d-none lesson-practice-audio">
                            <audio id="lesson-audio" controls preload="metadata"></audio>
                        </div>

                        <div class="lesson-practice-grid">
                            <div class="lesson-practice-text-column">
                                <div id="words-container" class="words-container" aria-live="polite"></div>
                                <p id="target-translation" class="lesson-translation"></p>

                                <div class="lesson-action-row">
                                    <button id="play-sample-btn"
                                            type="button"
                                            class="lesson-icon-button lesson-icon-button-blue"
                                            onclick="playCurrentSentenceAudio()"
                                            disabled>
                                        <i data-lucide="volume-2"></i>
                                        <span>Nghe mẫu</span>
                                    </button>
                                    <button id="favorite-sentence-btn"
                                            type="button"
                                            class="lesson-icon-button lesson-icon-button-favorite"
                                            aria-pressed="false">
                                        <i data-lucide="bookmark"></i>
                                        <span>Lưu câu</span>
                                    </button>
                                </div>
                            </div>

                            <div class="lesson-recorder-box">
                                <div class="lesson-recorder-copy">
                                    <p id="rec-status-text"
                                       class="lesson-rec-status"
                                       role="status"
                                       aria-live="polite">Nhấn nút xanh để bắt đầu thu âm.</p>
                                </div>

                                <div class="lesson-recorder-actions">
                                    <button id="record-btn"
                                            type="button"
                                            class="lesson-record-button"
                                            onclick="toggleRecording()"
                                            aria-label="Bắt đầu thu âm">
                                        <i data-lucide="mic"></i>
                                        <span id="record-btn-label">BẮT ĐẦU THU ÂM</span>
                                    </button>

                                    <button id="playback-btn"
                                            type="button"
                                            class="lesson-secondary-button d-none"
                                            onclick="playbackRecording()"
                                            aria-label="Nghe lại bản thu">
                                        <i data-lucide="headphones"></i>
                                        <span>Nghe lại</span>
                                    </button>

                                    <button id="clear-btn"
                                            type="button"
                                            class="lesson-secondary-button d-none"
                                            onclick="clearRecording()"
                                            aria-label="Xóa bản thu">
                                        <i data-lucide="rotate-ccw"></i>
                                        <span>Thu lại</span>
                                    </button>

                                    <button id="next-sentence-btn"
                                            type="button"
                                            class="lesson-next-button d-none"
                                            onclick="advanceSentence()"
                                            aria-label="Câu tiếp theo">
                                        <span>Câu tiếp theo</span>
                                        <i data-lucide="arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </article>
                </section>
            </div>

            <aside class="lesson-panel lesson-score-panel lesson-ai-side-card" aria-label="Chấm điểm AI">
                <div class="lesson-panel-head">
                    <div>
                        <span class="lesson-panel-kicker lesson-panel-kicker-red">Chấm điểm AI</span>
                    </div>
                </div>


                <div class="lesson-score-layout">
                    <div class="score-ring-section">
                        <div id="score-ring-wrap" class="score-ring-wrap">
                            <svg class="score-svg" viewBox="0 0 128 128" aria-hidden="true">
                                <circle cx="64" cy="64" r="58" fill="none" stroke="#e2e8f0" stroke-width="10" />
                                <circle id="score-ring" cx="64" cy="64" r="58"
                                        fill="none" stroke="#e2e8f0" stroke-width="10"
                                        stroke-linecap="round"
                                        transform="rotate(-90 64 64)"
                                        style="stroke-dasharray:364;stroke-dashoffset:364;transition:stroke-dashoffset 0.6s ease,stroke 0.4s ease;" />
                            </svg>
                            <div class="score-center">
                                <span id="score-num" class="score-num">--</span>
                                <span class="score-unit">%</span>
                            </div>
                        </div>

                        <div id="score-loading" class="d-none lesson-score-loading">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Đang chấm điểm...</span>
                            </div>
                            <p>Đang chấm điểm...</p>
                        </div>
                    </div>

                    <div class="lesson-score-copy">
                        <h2 id="score-feedback-title" class="score-feedback-title text-muted">Chưa có dữ liệu</h2>
                        <p id="score-feedback-sub">Nghe mẫu rồi thu âm câu hiện tại.</p>
                    </div>

                    <textarea id="ai-detailed-feedback"
                              class="ai-feedback-textarea"
                              rows="5"
                              readonly
                              aria-label="Nhận xét chi tiết của AI">@(!pronunciationAiConfigured ? "Chưa kết nối AI, vui lòng kiểm tra lại!" : string.Empty)</textarea>
                </div>
            </aside>
        </section>

        <section id="dictation-tab-panel" class="lesson-exercise-panel d-none" role="tabpanel" aria-labelledby="dictation-tab">
            @if (supportsDictation)
            {
                <article class="lesson-panel lesson-focused-exercise">
                    <div class="lesson-panel-head"><div><span class="lesson-panel-kicker lesson-panel-kicker-blue">Nghe chép</span><h2>Gõ lại câu bạn nghe</h2></div><span id="dictation-progress" class="lesson-time-chip">1 / 1</span></div>
                    <p class="text-body-muted">Không phân biệt chữ hoa, chữ thường và dấu câu.</p>

                    <!-- Symbolic Audio Progress Simulator -->
                    <div class="dictation-audio-simulation">
                        <button type="button" class="simulation-play-btn" id="dictation-play" aria-label="Phát hoặc Dừng nghe câu">
                            <i data-lucide="play" id="dictation-play-icon"></i>
                        </button>
                        <div class="simulation-body">
                            <div class="simulation-track">
                                <div id="dictation-progress-bar" class="simulation-fill"></div>
                            </div>
                            <div class="simulation-time">
                                <span id="dictation-current-time">0:00</span>
                                <span id="dictation-total-time">0:00</span>
                            </div>
                        </div>
                    </div>
                    <label class="visually-hidden" for="dictation-answer">Câu bạn nghe được</label>
                    <textarea id="dictation-answer" class="form-control lesson-answer-input" rows="3" placeholder="Nhập câu tiếng Anh bạn nghe được..."></textarea>
                    <div id="dictation-result" class="lesson-inline-result" role="status" aria-live="polite"></div>
                    <div class="lesson-exercise-actions"><button type="button" class="lesson-secondary-button" id="dictation-submit">Kiểm tra</button><button type="button" class="dictation-next-button d-none" id="dictation-next"><span>Câu tiếp theo</span><i data-lucide="arrow-right" aria-hidden="true"></i></button></div>
                </article>
            }
            else
            {
                <article class="lesson-panel lesson-upgrade-state">
                    <i data-lucide="clock-3"></i>
                    <h2>Nghe chép cho bài học audio sắp ra mắt</h2>
                    <p>Chúng tôi đang bổ sung mốc thời gian cho từng câu để phát đúng đoạn audio cần nghe.</p>
                </article>
            }
        </section>

        <section id="ipa-match-tab-panel" class="lesson-exercise-panel d-none" role="tabpanel" aria-labelledby="ipa-match-tab">
            <article class="lesson-panel lesson-focused-exercise">
                <div class="lesson-panel-head"><div><span class="lesson-panel-kicker lesson-panel-kicker-violet">Ghép từ với phiên âm</span><h2>IPA nào thuộc về từ này?</h2></div><span id="ipa-progress" class="lesson-time-chip">1 / 1</span></div>
                <p id="ipa-context" class="ipa-match-context"></p>
                <p id="ipa-word" class="ipa-match-word">English word</p>
                <div id="ipa-options" class="ipa-options" role="radiogroup" aria-label="Các lựa chọn phiên âm"></div>
                <div id="ipa-result" class="lesson-inline-result" role="status" aria-live="polite"></div>
                <div class="ipa-match-actions">
                    <button type="button" class="lesson-secondary-button" id="ipa-prev"><i data-lucide="arrow-left"></i> Quay lại</button>
                    <button type="button" class="lesson-record-button" id="ipa-submit">Kiểm tra</button>
                    <button type="button" class="lesson-record-button ipa-btn-success d-none" id="ipa-next">Câu tiếp theo <i data-lucide="arrow-right"></i></button>
                </div>
            </article>
        </section>

        <section id="ai-dialogue-tab-panel" class="lesson-exercise-panel d-none" role="tabpanel" aria-labelledby="ai-dialogue-tab">
            @if (!isVip)
            {
                <article class="lesson-panel lesson-upgrade-state lesson-vip-upgrade">
                    <span class="lesson-upgrade-icon" aria-hidden="true"><i data-lucide="messages-square"></i></span>
                    <div class="lesson-upgrade-copy">
                        <span class="lesson-upgrade-kicker">Dành cho thành viên VIP</span>
                        <h2>Mở phòng đối thoại AI</h2>
                        <p>Luyện role-play theo bài học, gửi voice message và nghe AI trả lời.</p>
                    </div>
                    <a asp-action="Settings" asp-route-checkout="vip" class="lesson-upgrade-button">
                        <span>Xem gói VIP</span>
                        <i data-lucide="arrow-right" aria-hidden="true"></i>
                    </a>
                </article>
            }
            else
            {
                <article class="lesson-panel dialogue-workspace">
                    <div class="lesson-panel-head"><span id="dialogue-turn-count" class="lesson-time-chip">0 / 30</span></div>
                    <div id="dialogue-messages" class="dialogue-messages" aria-live="polite"><div class="dialogue-empty">Đang kết nối cuộc trò chuyện...</div></div>
                    <div class="dialogue-composer"><label class="visually-hidden" for="dialogue-input">Tin nhắn tiếng Anh</label><input id="dialogue-input" class="form-control" maxlength="2000" placeholder="Type your message in English..." /><button type="button" id="dialogue-send" class="lesson-secondary-button">Gửi</button><button type="button" id="dialogue-record" class="lesson-record-button lesson-record-button-small"><i data-lucide="mic"></i><span>Thu âm</span></button></div>
                    <p id="dialogue-status" class="lesson-inline-result" role="status"></p>
                </article>
            }
        </section>

        <section class="lesson-subtitles-section" aria-label="Phụ đề" data-shadowing-content>
            <article class="lesson-panel lesson-subtitle-panel">

                <ol id="subtitle-list" class="subtitle-list" aria-label="Danh sách câu luyện tập"></ol>
            </article>
        </section>
    </section>
</main>

@section Scripts {
    <script defer src="~/js/lesson-shadowing.js" asp-append-version="true"></script>
    <script defer src="~/js/lesson-practice-tabs.js" asp-append-version="true"></script>
    @if (isAiLesson)
    {
        <script defer src="~/js/ai-lesson-detail.js" asp-append-version="true"></script>
    }
}
