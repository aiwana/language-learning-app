        // Highlight selected row in subtitle drawer
        function renderSubtitlesHighlight(options = {}) {
            const { scroll = false } = options;

            lesson.Sentences.forEach((_, idx) => {
                const row = document.getElementById(`sub-row-${idx}`);
                if (!row) return;
                row.classList.toggle('is-active', idx === state.activeSentenceIndex);
            });

            if (!scroll) return;

            const container = document.getElementById("subtitles-list-container");
            const activeRow = document.getElementById(`sub-row-${state.activeSentenceIndex}`);
            if (!container || !activeRow) return;

            const containerRect = container.getBoundingClientRect();
            const rowRect = activeRow.getBoundingClientRect();
            const rowTop = rowRect.top - containerRect.top + container.scrollTop;
            const rowBottom = rowTop + activeRow.offsetHeight;
            const viewTop = container.scrollTop;
            const viewBottom = viewTop + container.clientHeight;

            if (rowTop < viewTop || rowBottom > viewBottom) {
                const target = rowTop - (container.clientHeight / 2) + (activeRow.offsetHeight / 2);
                container.scrollTop = Math.max(0, target);
            }
        }

        // Switch panel tabs
        function switchTab(tab) {
            state.activeTab = tab;

            const tabs = ['shadowing', 'roleplay', 'dictation', 'ipa-game'];
            tabs.forEach(t => {
                const btn = document.getElementById(`tab-${t.replace('-', '')}`);
                const panel = document.getElementById(`panel-${t}`);

                if (t === tab) {
                    btn.className = "px-3 py-2 font-extrabold pb-2 border-b-2 cursor-pointer transition-colors whitespace-nowrap border-indigo-600 text-indigo-600 dark:border-sky-400 dark:text-sky-400";
                    panel.classList.remove("hidden");
